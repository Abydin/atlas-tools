_click_window_bounds = None


def click_xy(x, y, double=False, right=False, from_view=None):
    if from_view:
        sw = screen_width_points()
        x = int(round(x * sw / from_view))
        y = int(round(y * sw / from_view))
    cmd = "dc" if double else ("rc" if right else "c")
    out = cliclick("%s:%d,%d" % (cmd, x, y))
    out["x"] = x
    out["y"] = y
    # Off-window guard. `dom` reports viewport-relative rects, so an element
    # scrolled below the fold has a y larger than the window height and the
    # derived screen point lands past the window edge, on the desktop or on
    # whatever is behind. cliclick happily clicks there and reports ok, which
    # reads as "the control did not respond" and sends you debugging the page
    # instead of the coordinate. Cost real debugging time on a real web
    # form. Scroll the element in first (scrollIntoView) and
    # re-read its rect.
    if _click_window_bounds:
        wx, wy, ww, wh = _click_window_bounds
        if not (wx <= x <= wx + ww and wy <= y <= wy + wh):
            out["outsideWindow"] = True
            out["windowBounds"] = {"x": wx, "y": wy, "w": ww, "h": wh}
            out["warning"] = ("click point (%d,%d) is OUTSIDE the target window -- "
                              "the element is most likely scrolled out of view; "
                              "scrollIntoView it and re-read its rect" % (x, y))
    return out


def _frontmost_window_bounds():
    """Largest window of the frontmost app, as (x, y, w, h). Best-effort: any
    failure returns None and the off-window guard simply stays quiet."""
    global _click_window_bounds
    try:
        win = run_jxa_ax("windows", {})
        if "error" in win or not win.get("windows"):
            return None
        w = sorted(win["windows"], key=lambda d: (d.get("w") or 0) * (d.get("h") or 0),
                   reverse=True)[0]
        return (w.get("x", 0), w.get("y", 0), w.get("w", 0), w.get("h", 0))
    except Exception:
        return None


def cmd_click_xy(args):
    global _click_window_bounds
    _click_window_bounds = _frontmost_window_bounds()
    out = click_xy(args.x, args.y, args.double, args.right, args.from_view)
    print(json.dumps(out))
    if "error" in out:
        sys.exit(1)


def find_one(role, name, index, app, window_index=0, limit=50):
    found = run_jxa_ax("find", {"app": app, "role": role, "name": name,
                                 "limit": limit, "windowIndex": window_index})
    if "error" in found:
        return None, found
    matches = found.get("matches", [])
    if index >= len(matches):
        return None, {"error": "no match at index %d (found %d matches for role=%s name=%s)"
                                % (index, len(matches), role, name)}
    return matches[index], None


def ax_press(role, name, index, app):
    """
    Perform the element's own default AX action (AXPress, via System
    Events' `click` command on the UI element reference) instead of moving
    the mouse to a computed point. Preferred over a coordinate click:
    doesn't misfire if the element is scrolled, partially occluded, or the
    window has moved since `find` last reported its position. Not every
    element supports a default action (custom canvas-drawn controls,
    disabled elements), that's an expected failure, the caller should fall
    back to coordinate-click when this returns an error.
    """
    return run_jxa_ax("press", {"app": app, "role": role, "name": name, "index": index})


# ---------------------------------------------------------------------------
# click --selector: web mode (Bug #5's other half). Native AX-press (above)
# stays exactly as it was for native apps -- this is ONLY for web content,
# where a card/button may have no reliable AX role at all.
# ---------------------------------------------------------------------------

def _click_web_signature_js():
    """Snapshot the marked target's own state signature plus two page-wide
    signals (location.href, document.body.childElementCount) that catch a
    click that navigated or mounted/unmounted content rather than toggling
    the element's own attributes. Also returns the element's rect so a
    real-click escalation, if needed, doesn't have to re-resolve it."""
    return (
        "(function(){"
        "var el=document.querySelector('[data-atlas-select-target]');"
        "if(!el)return JSON.stringify({status:'error',reason:'target-lost',"
        "detail:'target element lost (page may have re-rendered)'});"
        "var r=el.getBoundingClientRect();"
        "return JSON.stringify({status:'read',signature:{"
        "ariaPressed:el.getAttribute('aria-pressed'),"
        "ariaSelected:el.getAttribute('aria-selected'),"
        "className:el.className,"
        "href:location.href,"
        "bodyCount:document.body.childElementCount},"
        "rect:{vx:r.x,vy:r.y,vw:r.width,vh:r.height}});"
        "})()"
    )


def _click_web_dispatch_js():
    """Full pointer/mouse/click sequence on the marked target -- the same
    dispatched-event style _combobox_open_js's trigger uses (works for
    handlers that don't require event.isTrusted; the elements that DO
    require it are exactly what the signature-unchanged path below
    escalates to a real click for)."""
    return (
        "(function(){"
        "var el=document.querySelector('[data-atlas-select-target]');"
        "if(!el)return JSON.stringify({status:'error',reason:'target-lost',"
        "detail:'target element lost (page may have re-rendered)'});"
        "var opts={bubbles:true,cancelable:true,view:window};"
        "try{el.dispatchEvent(new PointerEvent('pointerdown',opts));}catch(e){}"
        "el.dispatchEvent(new MouseEvent('mousedown',opts));"
        "try{el.dispatchEvent(new PointerEvent('pointerup',opts));}catch(e){}"
        "el.dispatchEvent(new MouseEvent('mouseup',opts));"
        "el.dispatchEvent(new MouseEvent('click',opts));"
        "return JSON.stringify({status:'dispatched'});"
        "})()"
    )


def click_web(browser, selector, name, index):
    if not _is_app_running(browser):
        return make_envelope(False, "click", False, reason="app-not-running",
                              detail="%s is not running, click will not auto-launch a browser, "
                                     "open it first" % browser)

    ok, out, err = _arc_execute_js(_resolve_select_target_js(selector, name, index), browser)
    if not ok or not out:
        return make_envelope(False, "click", False, reason="execute-js-failed",
                              detail="resolving target: " + (err or "empty result"))
    try:
        resolved = _parse_js_json(out)
    except ValueError as e:
        return make_envelope(False, "click", False, reason="json-parse-failed",
                              detail="resolve-target: %s (raw: %s)" % (e, out[:300]))
    if resolved.get("status") == "error":
        return make_envelope(False, "click", False, reason=resolved.get("reason", "resolve-failed"),
                              detail=resolved.get("detail"))
    label = resolved.get("text") or name
    target = {"tag": resolved.get("tag"), "selector": selector, "label": label, "rect": None}

    def _read_signature():
        ok_s, out_s, err_s = _arc_execute_js(_click_web_signature_js(), browser)
        if not ok_s or not out_s:
            return None, "execute-js-failed reading signature: " + (err_s or "empty result")
        try:
            r = _parse_js_json(out_s)
        except ValueError as e:
            return None, "json-parse-failed: %s" % e
        if r.get("status") == "error":
            return None, r.get("detail")
        return r, None

    snap1, err1 = _read_signature()
    if snap1 is None:
        _arc_execute_js(_cleanup_markers_js(), browser)
        return make_envelope(False, "click", False, reason="signature-read-failed", detail=err1, target=target)
    target["rect"] = snap1.get("rect")

    ok2, out2, err2 = _arc_execute_js(_click_web_dispatch_js(), browser)
    if not ok2 or not out2:
        _arc_execute_js(_cleanup_markers_js(), browser)
        return make_envelope(False, "click", False, reason="execute-js-failed",
                              detail="dispatching click: " + (err2 or "empty result"), target=target)

    time.sleep(0.12)
    snap2, err2b = _read_signature()
    if snap2 is None:
        _arc_execute_js(_cleanup_markers_js(), browser)
        return make_envelope(False, "click", False, reason="signature-read-failed", detail=err2b, target=target)

    if snap2.get("signature") != snap1.get("signature"):
        _arc_execute_js(_cleanup_markers_js(), browser)
        return make_envelope(True, "click", True, verifiedBy="state-change", method="js",
                              target=target, coords=None)

    # Signature unchanged -- the dispatched click was ignored (the
    # isTrusted-gated case Bug #5/#2 both hit). Escalate to a real click at
    # the element's own rect, same primitive `select` uses.
    def _verify_state_change():
        snap3, err3 = _read_signature()
        if snap3 is None:
            return False, None, err3
        changed = snap3.get("signature") != snap1.get("signature")
        return changed, ("state-change" if changed else None), snap3

    rc = real_click_verified(browser, snap1.get("rect") or {}, _verify_state_change)
    _arc_execute_js(_cleanup_markers_js(), browser)
    if rc["ok"]:
        return make_envelope(True, "click", True, verifiedBy=rc["verifiedBy"], method="js->real-click",
                              target=target, coords=rc["coords"])
    return make_envelope(False, "click", False, method="js->real-click", target=target,
                          coords=rc.get("coords"), reason=rc.get("reason", "not-verified-after-real-click"),
                          detail=rc.get("detail"))


def cmd_click(args):
    if args.selector:
        out = click_web(args.app or "Arc", args.selector, args.name, args.index)
        print(json.dumps(out))
        if not out.get("ok"):
            sys.exit(1)
        return

    if not args.role or not args.name:
        die("click needs --role and --name (native AX mode) or --selector (web mode)")

    if args.double or args.right:
        # AXPress has no double/right-click equivalent; go straight to the
        # coordinate path for those.
        el, err = find_one(args.role, args.name, args.index, args.app)
        if err:
            print(json.dumps(err))
            sys.exit(1)
        out = click_xy(el["cx"], el["cy"], args.double, args.right)
        out["matchedElement"] = el
        out["method"] = "coordinate-click"
        print(json.dumps(out))
        if "error" in out:
            sys.exit(1)
        return

    press_out = ax_press(args.role, args.name, args.index, args.app)
    if "error" not in press_out:
        press_out["method"] = "ax-press"
        print(json.dumps(press_out))
        return

    # AXPress failed or unsupported -- fall back to a coordinate click.
    el, err = find_one(args.role, args.name, args.index, args.app)
    if err:
        err["axPressError"] = press_out.get("error")
        print(json.dumps(err))
        sys.exit(1)
    out = click_xy(el["cx"], el["cy"])
    out["matchedElement"] = el
    out["method"] = "coordinate-click"
    out["axPressError"] = press_out.get("error")
    print(json.dumps(out))
    if "error" in out:
        sys.exit(1)


def cmd_type(args):
    if args.text == "":
        # empty text is a legitimate no-op (e.g. a caller building the string
        # programmatically that happened to end up empty), not an error.
        out = {"ok": True, "noop": True}
        if args.enter:
            out["enterResult"] = run_jxa_key("return", {})
        print(json.dumps(out))
        return
    out = cliclick("t:%s" % args.text)
    if args.enter and "error" not in out:
        key_out = run_jxa_key("return", {})
        out["enterResult"] = key_out
    print(json.dumps(out))
    if "error" in out:
        sys.exit(1)


def cmd_key(args):
    out = run_jxa_key(args.key, {
        "cmd": args.cmd, "shift": args.shift,
        "option": args.option, "control": args.control,
    })
    print(json.dumps(out))
    if "error" in out:
        sys.exit(1)


def cmd_scroll(args):
    # cliclick 5.1 has no scroll-wheel command (checked: no "s:"/scroll
    # command exists in its help output). Approximate with repeated arrow-key
    # presses via System Events -- scrolls most content views but is not a
    # true wheel-delta event; some web widgets that specifically listen for
    # wheel events may not respond. amount = number of key presses, not lines.
    if args.amount < 0:
        die("scroll --amount must be >= 0, got %d" % args.amount)
    if args.amount == 0:
        print(json.dumps({"ok": True, "presses": 0, "direction": args.direction, "noop": True}))
        return
    key = "down" if args.direction == "down" else "up"
    results = []
    for _ in range(args.amount):
        results.append(run_jxa_key(key, {}))
        time.sleep(0.02)
    errored = [r for r in results if "error" in r]
    out = {"ok": len(errored) == 0, "presses": len(results), "direction": args.direction}
    if errored:
        out["error"] = errored[0]["error"]
    print(json.dumps(out))
    if errored:
        sys.exit(1)


def cmd_wait(args):
    if args.dom:
        cmd_wait_dom(args)
        return

    deadline = time.time() + args.timeout
    last_err = None
    while time.time() < deadline:
        el, err = find_one(args.role, args.name, args.index, args.app)
        if el:
            out = {"ok": True, "found": True, "element": el}
            if args.click:
                click_out = click_xy(el["cx"], el["cy"])
                out["clickResult"] = click_out
                if "error" in click_out:
                    print(json.dumps(out))
                    sys.exit(1)
            print(json.dumps(out))
            return
        last_err = err
        time.sleep(0.3)
    out = {"ok": False, "found": False, "timedOut": True}
    if last_err:
        out["lastError"] = last_err
    print(json.dumps(out))
    sys.exit(1)


def cmd_wait_dom(args):
    """
    Poll the Arc DOM (not the AX tree) every ~0.5s until an element matches.
    For JS-rendered content (React/Svelte/etc. lazy-mounted buttons) that
    the Accessibility tree can't see because it hasn't been walked/exposed
    yet, or is a plain <div onclick> with no AX role at all.

    --role matches against the element's HTML TAG (case-insensitive,
    "any"/empty matches every tag); --name matches as a case-insensitive
    substring of the element's visible text. This mirrors AX `wait`'s
    role/name shape so callers don't have to learn a second vocabulary.
    """
    browser = args.app or "Arc"
    deadline = time.time() + args.timeout
    last_result = None
    while time.time() < deadline:
        result = dom_query(browser, DEFAULT_DOM_SELECTOR, 300, args.top_chrome, args.left_chrome)
        if "error" in result:
            last_result = result
            time.sleep(0.5)
            continue
        role_wanted = (args.role or "any").lower()
        name_wanted = (args.name or "").lower()
        for el in result.get("elements", []):
            tag_match = role_wanted in ("any", "") or (el.get("tag") or "").lower() == role_wanted
            name_match = not name_wanted or name_wanted in (el.get("text") or "").lower()
            if tag_match and name_match:
                out = {"ok": True, "found": True, "element": el, "mode": "dom"}
                if args.click and el.get("x") is not None:
                    click_out = click_xy(el["x"], el["y"])
                    out["clickResult"] = click_out
                    if "error" in click_out:
                        print(json.dumps(out))
                        sys.exit(1)
                print(json.dumps(out))
                return
        last_result = result
        time.sleep(0.5)
    out = {"ok": False, "found": False, "timedOut": True, "mode": "dom"}
    if last_result:
        out["lastDomQuery"] = last_result
    print(json.dumps(out))
    sys.exit(1)


