def cmd_screenshot(args):
    scratchpad_default = os.path.join(tempfile.gettempdir(), "desktop-cli-scratchpad")
    scratchpad = os.environ.get("ATLAS_SCRATCHPAD", scratchpad_default)
    ts = int(time.time())
    out_path = args.outpath or os.path.join(scratchpad, "shot_%d.jpg" % ts)
    raw_png = "/tmp/desktop_shot_raw_%d.png" % ts

    # A bare filename (no directory component) makes os.path.dirname return
    # "", which os.makedirs("") used to raise on -- fall back to "." (the
    # cwd, which always exists) instead of crashing.
    os.makedirs(os.path.dirname(out_path) or ".", exist_ok=True)

    # Display resolution (Bug #3 fix): "auto" (the default) resolves WHICH
    # display --app's window is actually on via resolve_window_display(),
    # instead of always assuming display 1 -- a screenshot used to always
    # come back "display 1" downsampled regardless of which physical
    # display the window was really on, hiding the real click-landing
    # question during the live UXCam session. An explicit --display N
    # (1-based, matching screencapture's -D numbering) still overrides.
    display_resolution_note = None
    if args.display == "auto":
        info = resolve_window_display(args.app) if _is_app_running(args.app) else None
        if info and info.get("screenIndex") is not None and info.get("trustworthy"):
            resolved_display = info["screenIndex"] + 1  # screencapture -D is 1-based
        else:
            resolved_display = 1
            display_resolution_note = ("could not resolve %s's active display (app not running, "
                                        "no window, or untrustworthy screen match), fell back to "
                                        "display 1" % args.app)
    else:
        try:
            resolved_display = int(args.display)
        except (TypeError, ValueError):
            die("--display must be 'auto' or an integer, got %r" % args.display)

    # Pin the capture to ONE display (-D, 1-based). Without -D, screencapture
    # on a multi-display setup stitches ALL displays into a single image,
    # which silently breaks --from-view scaling (click_xy's screen width
    # query is single-display). -C composites the live cursor into the
    # capture (see the open item in the rebuild spec about verifying this
    # on this macOS -- cursor position is ALSO reported numerically below
    # regardless, so a caller isn't dependent on the composite working).
    cap = subprocess.run(["/usr/sbin/screencapture", "-x", "-C", "-D", str(resolved_display), raw_png],
                          capture_output=True, text=True)
    if cap.returncode != 0:
        die("screencapture failed: " + cap.stderr.strip())

    sip = subprocess.run(
        ["/usr/bin/sips", "-Z", "1600", "-s", "format", "jpeg", "-s", "formatOptions", "60",
         raw_png, "--out", out_path],
        capture_output=True, text=True,
    )
    try:
        os.remove(raw_png)
    except OSError:
        pass
    if sip.returncode != 0:
        die("sips downsample failed: " + sip.stderr.strip())

    out = {"ok": True, "path": out_path, "viewWidth": 1600, "display": resolved_display,
           "cursor": _cliclick_cursor_position()}
    if display_resolution_note:
        out["displayResolutionNote"] = display_resolution_note
    print(json.dumps(out))


# ---------------------------------------------------------------------------
# calibrate: self-verifying top-chrome AND left-chrome measurement. INJECTS
# INPUT (clicks), only run this when the desktop is confirmed free -- see
# README.
#
# DESIGN NOTE (revised twice): a first version opened a throwaway tab at a
# data:text/html page and coarse-swept candidate top_chrome values with
# multiple clicks. A live run found Arc's AppleScript dictionary REJECTS
# data:/about:blank URLs on `make new tab` (error -1701, "Please provide a
# valid URL property") -- it only accepts real http(s) URLs. That live run
# also confirmed injecting an overlay into a tab and reading its rect back
# via `execute javascript` works perfectly, which drove a redesign to an
# IN-PLACE, single-corrective-click approach for the Y axis (top_chrome)
# only, the X axis (left_chrome) was still just assumed equal to
# (outerW - innerW). A SECOND live run of that Y-only version converged Y
# perfectly (top_chrome corrected 52 -> 42, confirmed within 3px) but
# revealed the X assumption was ALSO wrong: the confirming click was off by
# a constant ~90pt on X (modeled left chrome 327 vs the page reporting the
# click landed as if the real left chrome were 417). So this now corrects
# BOTH axes from the SAME single click, no second round needed:
#
#   1. Inject a FULL-VIEWPORT fixed overlay (position:fixed; inset:0;
#      z-index:2147483647) into the active tab. Because it covers the whole
#      viewport, a click ANYWHERE on the page lands on the overlay and
#      CANNOT leak through to the real page underneath -- click-safe even if
#      the current top_chrome/left_chrome guesses are wildly wrong, whatever
#      tab is open is protected.
#   2. Compute the absolute screen point for a known viewport target
#      (CALIBRATION_TARGET_VX/VY) using the CURRENT top_chrome AND
#      left_chrome guesses, click it once, then read back
#      window.__atlas_cal, which the overlay's own click handler set to the
#      click's REAL clientX/clientY as the page itself sees it.
#   3. The gap between where we AIMED (the known target) and where the page
#      says the click actually landed is exactly the chrome error, on BOTH
#      axes independently. Correct both once, click again to confirm within
#      ~3px on BOTH axes, remove the overlay, persist. No sweep needed on
#      either axis.
#
# SIGN DERIVATION (so the correction isn't just an asserted guess, worked
# out identically on both axes from this toolkit's own formulas):
#   absScreenY = windowY + top_chrome  + viewportY
#   absScreenX = windowX + left_chrome + viewportX
# We told cliclick to click at
#   absScreenY_target = windowY + top_chrome_guess  + target_vy
#   absScreenX_target = windowX + left_chrome_guess + target_vx
# and the page reports that SAME physical point corresponds to viewport
# (reported_clientX, reported_clientY), via the SAME formulas but with the
# TRUE offsets, so on Y:
#   windowY + top_chrome_guess + target_vy == windowY + top_chrome_true + reported_clientY
#     => top_chrome_true = top_chrome_guess - (reported_clientY - target_vy)
# and identically on X:
#   windowX + left_chrome_guess + target_vx == windowX + left_chrome_true + reported_clientX
#     => left_chrome_true = left_chrome_guess - (reported_clientX - target_vx)
# i.e. true = guess - delta, delta = reported - target, same sign on both axes.
# Y sanity-checked with numbers and CONFIRMED LIVE (true=52 measured as 52,
# from a guess of 30: delta=178-200=-22, guess-delta=30-(-22)=52, matches;
# separately the second live run measured true=42 from guess=52 and
# converged perfectly). X sanity-checked with the SECOND live run's own
# numbers: guess=327, target_vx=200, reported_clientX=110 (both clicks,
# uncorrected): left_chrome_true = 327 - (110-200) = 327 + 90 = 417, matching
# the live diagnosis exactly.
#
# A `--method newtab` fallback is kept (see _open_calibration_tab_http)
# for the rare case in-place injection isn't viable (e.g. a page whose CSP
# blocks inline style/script injection); it needs network (a real http(s)
# URL, data:/about:blank are rejected) and is otherwise the same
# single-click overlay technique, just run against a fresh blank-ish tab
# instead of whatever's currently open.
# ---------------------------------------------------------------------------

CALIBRATION_TARGET_VX = 200
CALIBRATION_TARGET_VY = 200
CALIBRATION_CONFIRM_TOLERANCE_PX = 3
CALIBRATION_FALLBACK_URL = "https://example.com"


def _arc_inject_calibration_overlay(browser, target_vx, target_vy):
    """
    Adds a full-viewport, top-z-index, click-catching overlay to the active
    tab, plus a small visible marker at (target_vx, target_vy) for anyone
    watching the screen during a live run. The overlay's click handler
    records event.clientX/clientY (the page's own view of where the click
    landed) into window.__atlas_cal, overwriting it on every click, so each
    click's result can be read back fresh with no reset needed in between.
    """
    js = (
        "(function(){"
        "var old=document.getElementById('__atlas_cal_overlay');if(old)old.remove();"
        "window.__atlas_cal=null;"
        "var ov=document.createElement('div');"
        "ov.id='__atlas_cal_overlay';"
        "ov.style.cssText='position:fixed;inset:0;z-index:2147483647;"
        "background:rgba(0,0,0,0.001);cursor:crosshair;';"
        "ov.addEventListener('click',function(e){"
        "window.__atlas_cal={clientX:e.clientX,clientY:e.clientY};"
        "e.preventDefault();e.stopPropagation();"
        "},true);"
        "var mk=document.createElement('div');"
        "mk.style.cssText='position:fixed;left:%dpx;top:%dpx;width:10px;height:10px;"
        "border-radius:50%%;background:red;pointer-events:none;';"
        "ov.appendChild(mk);"
        "document.body.appendChild(ov);"
        "return true;"
        "})()"
    ) % (target_vx - 5, target_vy - 5)
    ok, out, err = _arc_execute_js(js, browser)
    if not ok or out in ("missing value", ""):
        return False, err or "overlay injection returned no result"
    return True, None


def _arc_read_calibration_click(browser):
    """Read back window.__atlas_cal; None if no click has landed on the overlay yet."""
    ok, out, _err = _arc_execute_js("JSON.stringify(window.__atlas_cal)", browser)
    if not ok or not out:
        return None
    try:
        decoded = json.loads(out) if out.startswith('"') else out
        parsed = json.loads(decoded)
    except ValueError:
        return None
    return parsed  # dict {clientX, clientY}, or None if JSON.stringify(null) decoded to None


def _arc_remove_calibration_overlay(browser):
    """Best-effort cleanup: removes the overlay/marker, leaves nothing behind on the page."""
    js = ("(function(){var ov=document.getElementById('__atlas_cal_overlay');"
          "if(ov)ov.remove();try{delete window.__atlas_cal;}catch(e){window.__atlas_cal=undefined;}"
          "return true;})()")
    _arc_execute_js(js, browser)


def _open_calibration_tab_http(browser, url=CALIBRATION_FALLBACK_URL):
    """
    FALLBACK path only (--method newtab): opens a NEW tab at a real http(s)
    URL (data:/about:blank are rejected by Arc's AppleScript dictionary with
    error -1701, confirmed live) and does NOT touch the caller's existing
    active tab. New tabs become the active tab by default in Chromium-family
    browsers, so the subsequent `execute javascript` calls (which always
    target "front window's active tab", never the `make new tab` return
    value, which comes back as `missing value` and can't be addressed
    directly, confirmed live as error -1708) reach it correctly without any
    extra tab-by-index bookkeeping. Needs network. Returns (ok, error).
    """
    literal = url.replace("\\", "\\\\").replace('"', '\\"')
    script = (
        'tell application "%s" to tell front window to make new tab '
        'with properties {URL:"%s"}'
    ) % (browser, literal)
    proc = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if proc.returncode != 0:
        return False, proc.stderr.strip()
    return True, None


def _close_calibration_tab(browser):
    """
    FALLBACK path only: best-effort close of whatever is currently the
    active tab (our throwaway tab, assuming nothing else changed the active
    tab in between). Chromium-family browsers typically reactivate whatever
    was active before the closed one was opened, but that's the browser's
    own behavior, not something this script enforces or verifies.
    """
    subprocess.run(
        ["osascript", "-e", 'tell application "%s" to tell front window to close active tab' % browser],
        capture_output=True, text=True,
    )


def _run_single_click_calibration(browser, ax_frame, top_chrome_guess, left_chrome_guess):
    """
    The shared in-place, single-click calibration routine, used by both the
    default (--method inplace) and fallback (--method newtab) flows once
    they've each set up which tab to run it against. Corrects BOTH axes from
    one click (a live run found the X-axis default guess, outerW-innerW,
    was also wrong, off by ~90pt, not just the Y-axis one this was
    originally built to fix). Returns a result dict; caller is responsible
    for cleanup (removing the overlay / closing the fallback tab) and for
    persisting the result via save_calibration().

    ax_frame is the AX-reported window frame (Fix #1 ground truth, see
    _viewport_to_screen) -- window.screenX/screenY/outerWidth/outerHeight
    are NEVER used for the click-point math or the bounds guard here, same
    reasoning as everywhere else in this file: under a hardware-mirrored
    display they report the full mirrored display's origin/size, not the
    real window's.
    """
    ok, inject_err = _arc_inject_calibration_overlay(browser, CALIBRATION_TARGET_VX, CALIBRATION_TARGET_VY)
    if not ok:
        return {"ok": False, "error": "could not inject calibration overlay: " + str(inject_err)}

    abs_x_first = ax_frame["x"] + left_chrome_guess + CALIBRATION_TARGET_VX
    abs_y_first = ax_frame["y"] + top_chrome_guess + CALIBRATION_TARGET_VY

    # Safety bound: refuse to click outside the window's own screen rect on
    # EITHER axis. The overlay only protects clicks that land somewhere IN
    # the tab's viewport, if a badly wrong guess would send the click
    # entirely outside the browser window (onto the menu bar, another app,
    # off-screen), abort before clicking rather than trust the overlay to
    # save it.
    x_in_bounds = ax_frame["x"] <= abs_x_first <= ax_frame["x"] + ax_frame["w"]
    y_in_bounds = ax_frame["y"] <= abs_y_first <= ax_frame["y"] + ax_frame["h"]
    if not (x_in_bounds and y_in_bounds):
        _arc_remove_calibration_overlay(browser)
        return {"ok": False, "error": "computed calibration click point (%d,%d) falls outside "
                                       "the window's own bounds, aborted before clicking for safety"
                                       % (abs_x_first, abs_y_first)}

    click_xy(abs_x_first, abs_y_first)
    time.sleep(0.15)
    reported1 = _arc_read_calibration_click(browser)

    if not reported1:
        _arc_remove_calibration_overlay(browser)
        return {"ok": False, "error": "overlay reported no click (listener may not have fired, "
                                       "or the tab navigated away mid-calibration)"}

    # Same derivation on both axes, from this toolkit's own formulas
    # (absScreenY = windowY + top_chrome + viewportY,
    #  absScreenX = windowX + left_chrome + viewportX): the point we AIMED
    # at, using the guessed offset, and the point the page reports the
    # click actually landed at (using the TRUE offset) are the same
    # physical screen point, solving for the true offset gives
    # true = guess - (reported - target) on each axis independently.
    delta_y = reported1["clientY"] - CALIBRATION_TARGET_VY
    delta_x = reported1["clientX"] - CALIBRATION_TARGET_VX
    corrected_top_chrome = top_chrome_guess - delta_y
    corrected_left_chrome = left_chrome_guess - delta_x

    # Confirming second click at BOTH corrected offsets.
    abs_x_second = ax_frame["x"] + corrected_left_chrome + CALIBRATION_TARGET_VX
    abs_y_second = ax_frame["y"] + corrected_top_chrome + CALIBRATION_TARGET_VY
    click_xy(abs_x_second, abs_y_second)
    time.sleep(0.15)
    reported2 = _arc_read_calibration_click(browser)

    _arc_remove_calibration_overlay(browser)

    confirmed = bool(
        reported2
        and abs(reported2["clientY"] - CALIBRATION_TARGET_VY) <= CALIBRATION_CONFIRM_TOLERANCE_PX
        and abs(reported2["clientX"] - CALIBRATION_TARGET_VX) <= CALIBRATION_CONFIRM_TOLERANCE_PX
    )

    result = {
        "ok": confirmed,
        "topChrome": corrected_top_chrome,
        "leftChrome": corrected_left_chrome,
        "firstClick": {"absPoint": [abs_x_first, abs_y_first], "reported": reported1,
                        "topChromeGuess": top_chrome_guess, "leftChromeGuess": left_chrome_guess,
                        "deltaY": delta_y, "deltaX": delta_x},
        "secondClick": {"absPoint": [abs_x_second, abs_y_second], "reported": reported2},
    }
    if not confirmed:
        result["error"] = ("second confirming click did not land within %dpx of the target on "
                            "both axes, not persisting -- see firstClick/secondClick"
                            % CALIBRATION_CONFIRM_TOLERANCE_PX)
    return result


def _reset_browser_zoom(browser):
    """
    Resets page zoom to 100% (Cmd+0). Page zoom is a purely visual/CSS-pixel
    setting -- it does not touch form field values, scroll position, or
    navigation state, so this is safe to send mid-session. `calibrate`'s
    overlay-click math (CALIBRATION_TARGET_VX/VY added directly, no zoom
    scaling) assumes 1 CSS px == 1 physical point, i.e. 100% zoom, so this
    guarantees a clean calibration run regardless of whatever zoom level a
    tab happened to be left at; `dom`'s separate zoom-normalization (see
    dom_query()'s docstring) is what makes READING coordinates safe at any
    zoom afterward, calibration itself still needs a known 100% baseline.
    """
    run_jxa_ax("activate", {"app": browser})
    time.sleep(0.1)
    run_jxa_key("0", {"cmd": True})
    time.sleep(0.2)


def cmd_calibrate(args):
    browser = args.app

    if not _is_app_running(browser):
        die("%s is not running, calibrate needs it open with at least one tab" % browser)

    _reset_browser_zoom(browser)

    opened_fallback_tab = False
    if args.method == "newtab":
        opened, open_err = _open_calibration_tab_http(browser)
        if not opened:
            die("could not open the fallback calibration tab in %s (needs a real http(s) URL, "
                "data:/about:blank are rejected): %s" % (browser, open_err))
        opened_fallback_tab = True
        time.sleep(1.0)  # let the real page load over the network before injecting

    # ax_frame (Fix #1 ground truth) drives all the click-point math below;
    # win_metrics (JS self-report) is kept only for innerW/innerH/dpr, see
    # get_top_chrome/get_left_chrome/save_calibration.
    ax_frame = _arc_window_geometry(browser)
    win_metrics = _dom_window_metrics(browser)
    if not ax_frame or not win_metrics:
        if opened_fallback_tab:
            _close_calibration_tab(browser)
        die("could not read window geometry for calibration (is a tab active in %s?)" % browser)

    top_chrome_guess, _tcal, _tsrc, _tstale = get_top_chrome(browser, ax_frame, win_metrics, None)
    left_chrome_guess, _lcal, _lsrc, _lstale = get_left_chrome(browser, ax_frame, win_metrics, None)

    result = _run_single_click_calibration(browser, ax_frame, top_chrome_guess, left_chrome_guess)

    if opened_fallback_tab:
        _close_calibration_tab(browser)

    if not result["ok"]:
        print(json.dumps(result))
        sys.exit(1)

    # Stamp WHICH display/backing-scale this measurement is only valid on
    # (Bug #3 fix): a calibration silently applied after the window moved to
    # a different display was the root cause of the intermittent clicks.
    backing_scale, zoom_scale_trustworthy, screen_index = _screen_backing_scale_factor(ax_frame)
    display_index = screen_index if zoom_scale_trustworthy else None
    backing_scale_stamp = backing_scale if zoom_scale_trustworthy else None

    save_calibration(browser, result["topChrome"], result["leftChrome"], ax_frame, win_metrics,
                      display_index, backing_scale_stamp)
    result["savedTo"] = CALIBRATION_FILE
    result["displayIndex"] = display_index
    result["backingScale"] = backing_scale_stamp
    print(json.dumps(result))


# ---------------------------------------------------------------------------
# argparse wiring
# ---------------------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(
        prog="desktop",
        description="Universal macOS desktop-control CLI (native AX tree + Arc DOM + vision fallback).",
    )
    sub = p.add_subparsers(dest="subcommand", required=True)

    sub.add_parser("list-apps", help="list running GUI apps")

    sp = sub.add_parser("focus", help="bring an app to the foreground")
    sp.add_argument("--app", required=True)

    sp = sub.add_parser("windows", help="list windows of an app (default: frontmost)")
    sp.add_argument("--app", default=None)

    sp = sub.add_parser("find", help="query the AX tree for matching elements")
    sp.add_argument("--role", default="any",
                     help="button|textfield|checkbox|radiobutton|popupbutton|combobox|"
                          "menuitem|link|statictext|tab|row|cell|slider|any")
    sp.add_argument("--name", default=None, help="case-insensitive substring match")
    sp.add_argument("--limit", type=int, default=50)
    sp.add_argument("--app", default=None, help="default: frontmost app")
    sp.add_argument("--window-index", type=int, default=0)

    sp = sub.add_parser("dom", help="query the active tab's web page DOM (Arc only)")
    sp.add_argument("--app", default="Arc")
    sp.add_argument("--selector", default=DEFAULT_DOM_SELECTOR)
    sp.add_argument("--limit", type=int, default=200)
    sp.add_argument("--top-chrome", type=int, default=None, dest="top_chrome",
                     help="override the calibrated/guessed top-chrome height in points "
                          "(skips .calibration.json lookup)")
    sp.add_argument("--left-chrome", type=int, default=None, dest="left_chrome",
                     help="override the calibrated/guessed left-chrome width in points "
                          "(skips .calibration.json lookup)")

    sp = sub.add_parser("select", help="set a dropdown's value -- native <select> via JS "
                                        ".value + change event (no click at all); custom ARIA/"
                                        "react-select-style combobox via JS open+filter+poll "
                                        "THEN a REAL cliclick commit at the option's own rect "
                                        "(dispatched clicks are ignored by these widgets, "
                                        "confirmed live). Never opens the native OS <select> "
                                        "popup that CGEvents can't drive")
    sp.add_argument("--app", default="Arc")
    sp.add_argument("--selector", default=DEFAULT_SET_SELECT_SELECTOR,
                     help="CSS selector for candidate dropdown elements, default matches "
                          "native <select> AND common ARIA-combobox trigger patterns")
    sp.add_argument("--name", default=None,
                     help="case-insensitive substring match against the element's name/id/"
                          "aria-label/associated-<label>-text (or, for a combobox, its own "
                          "visible text), to disambiguate multiple dropdowns on the page")
    sp.add_argument("--index", type=int, default=0,
                     help="which matching element to use, 0-based, after --name filtering")
    sp.add_argument("--value", required=True,
                     help="option to select: matched by exact visible text first, then "
                          "substring visible text, then (native <select> only) exact option "
                          "value")
    sp.add_argument("--retries", type=int, default=3,
                     help="combobox mode only: re-open and retry the whole open+poll+real-click "
                          "cycle this many times if the real click didn't verify")

    sp = sub.add_parser("set-select", help="DEPRECATED alias for `select`, kept for one release. "
                                            "Same behavior, no --retries flag (uses the default)")
    sp.add_argument("--app", default="Arc")
    sp.add_argument("--selector", default=DEFAULT_SET_SELECT_SELECTOR)
    sp.add_argument("--name", default=None)
    sp.add_argument("--index", type=int, default=0)
    sp.add_argument("--value", required=True)

    sp = sub.add_parser("fill", help="set a web input/textarea's value via the React-safe "
                                      "native property setter + input/change/blur (Arc only). "
                                      "Replaces `type` for web content -- synthetic keystrokes "
                                      "never reached a single Arc web input, confirmed live; "
                                      "this is the fix. Verifies by reading el.value back, and "
                                      "watches for a validation-error node so a value that "
                                      "reached the form store but a validator still rejects "
                                      "surfaces as a hand-to-human escalation, not a false ok")
    sp.add_argument("selector", help="CSS selector for the target input/textarea/select")
    sp.add_argument("value", help="value to set")
    sp.add_argument("--name", default=None,
                     help="case-insensitive substring filter against the element's name/id/"
                          "aria-label/label text, to disambiguate multiple matches")
    sp.add_argument("--index", type=int, default=0,
                     help="which matching element to use, 0-based, after --name filtering")
    sp.add_argument("--enter", action="store_true", help="press Return after a verified fill")
    sp.add_argument("--app", default="Arc")
    sp.add_argument("--await-human", type=float, default=None, dest="await_human",
                     help="if a hand-to-human escalation fires, poll the field for up to this "
                          "many seconds for the error to clear (a human typing it manually) "
                          "instead of returning immediately")
    sp.add_argument("--no-verify", action="store_true", dest="no_verify",
                     help="skip the read-back verification (faster, but per the envelope's "
                          "ok==verified rule, ok can never be true when this is set)")

    sp = sub.add_parser("click", help="find an element by role+name (native AX apps), or by "
                                       "--selector (web content in Arc), then click it")
    sp.add_argument("--role", default=None, help="required unless --selector is given")
    sp.add_argument("--name", default=None,
                     help="AX name substring (native mode, required unless --selector), or a "
                          "case-insensitive substring filter against the matched web element "
                          "(--selector mode, optional)")
    sp.add_argument("--index", type=int, default=0)
    sp.add_argument("--app", default=None)
    sp.add_argument("--double", action="store_true")
    sp.add_argument("--right", action="store_true")
    sp.add_argument("--selector", default=None,
                     help="web mode (Arc only): CSS selector for the target element. Tries a "
                          "dispatched JS click first, escalates to a REAL click at the element's "
                          "rect if its own state didn't change (isTrusted-gated widgets)")

    sp = sub.add_parser("click-xy", help="click raw screen coordinates")
    sp.add_argument("x", type=int)
    sp.add_argument("y", type=int)
    sp.add_argument("--double", action="store_true")
    sp.add_argument("--right", action="store_true")
    sp.add_argument("--from-view", type=int, default=None, dest="from_view",
                     help="if coords were read off a screenshot shrunk to this width, scale up")

    sp = sub.add_parser("type", help="type text at the current focus. NATIVE APPS ONLY -- "
                                      "does NOT reach browser web inputs (confirmed live: "
                                      "synthetic keystrokes never put a character into a "
                                      "focused Arc web input). Use `fill` for web content")
    sp.add_argument("--text", required=True)
    sp.add_argument("--enter", action="store_true", help="press return after typing")

    sp = sub.add_parser("key", help="press a key combo")
    sp.add_argument("--key", required=True,
                     help="a character, or a named key: return/enter/tab/space/delete/"
                          "escape/left/right/up/down/home/end/pageup/pagedown/forwarddelete")
    sp.add_argument("--cmd", action="store_true")
    sp.add_argument("--shift", action="store_true")
    sp.add_argument("--option", action="store_true")
    sp.add_argument("--control", action="store_true")

    sp = sub.add_parser("scroll", help="approximate scroll via repeated arrow-key presses")
    sp.add_argument("--direction", required=True, choices=["up", "down"])
    sp.add_argument("--amount", type=int, default=5, help="number of key presses, not lines")

    sp = sub.add_parser("wait", help="poll locally until an element appears")
    sp.add_argument("--role", required=True,
                     help="AX role (see `find`), or with --dom: an HTML tag / 'any'")
    sp.add_argument("--name", required=True,
                     help="AX name substring, or with --dom: page-text substring")
    sp.add_argument("--index", type=int, default=0)
    sp.add_argument("--app", default=None)
    sp.add_argument("--timeout", type=float, default=10.0)
    sp.add_argument("--click", action="store_true", help="click the element once found")
    sp.add_argument("--dom", action="store_true",
                     help="poll the Arc DOM instead of the AX tree, for JS-rendered "
                          "content (React/Svelte lazy-mounted buttons) the AX tree can't see")
    sp.add_argument("--top-chrome", type=int, default=None, dest="top_chrome",
                     help="(--dom mode only) override the calibrated/guessed top-chrome height")
    sp.add_argument("--left-chrome", type=int, default=None, dest="left_chrome",
                     help="(--dom mode only) override the calibrated/guessed left-chrome width")

    sp = sub.add_parser("macro", help="run a stop-on-failure JSON action sequence")
    sp.add_argument("actions_json")

    sp = sub.add_parser("screenshot", help="FALLBACK: full-screen capture, downsampled")
    sp.add_argument("outpath", nargs="?", default=None)
    sp.add_argument("--display", default="auto",
                     help="'auto' (default): resolves whichever display --app's window is "
                          "actually on. Or a 1-based display index, matching screencapture's "
                          "-D numbering, to force a specific one.")
    sp.add_argument("--app", default="Arc", help="which app's window --display auto resolves against")

    sp = sub.add_parser("calibrate", help="INJECTS INPUT: auto-measure Arc's top-chrome height "
                                           "with one corrective click, no screenshot")
    sp.add_argument("--app", default="Arc")
    sp.add_argument("--method", choices=["inplace", "newtab"], default="inplace",
                     help="inplace (default): calibrate on the CURRENT active tab via a "
                          "click-safe full-viewport overlay, no new tab, no network. "
                          "newtab: fallback, opens a throwaway http(s) tab first (needs network)")

    return p


DISPATCH = {
    "list-apps": cmd_list_apps,
    "focus": cmd_focus,
    "windows": cmd_windows,
    "find": cmd_find,
    "dom": cmd_dom,
    "set-select": cmd_set_select,
    "select": cmd_select,
    "fill": cmd_fill,
    "click": cmd_click,
    "click-xy": cmd_click_xy,
    "type": cmd_type,
    "key": cmd_key,
    "scroll": cmd_scroll,
    "wait": cmd_wait,
    "macro": cmd_macro,
    "screenshot": cmd_screenshot,
    "calibrate": cmd_calibrate,
}


def main():
    parser = build_parser()
    args = parser.parse_args()
    DISPATCH[args.subcommand](args)


if __name__ == "__main__":
    main()
