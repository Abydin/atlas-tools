#!/usr/bin/python3
"""
desktop -- universal macOS desktop-control CLI for Atlas.

Drives ANY app (Finder, System Settings, VS Code, Notes, native dialogs, Arc's
own chrome) by element NAME via the Accessibility (AX) tree, plus reads INSIDE
a web page's DOM in Arc via `execute javascript`. Native-first, vision-fallback:
`find`/`dom` give exact coordinates from the app/page itself, so `screenshot`
+ eyeballing pixels is the LAST resort, not the default.

Deliberately uses the system python3 (/usr/bin/python3, shebang above), NOT
homebrew python -- avoids the launchd/homebrew python-path and missing-module
class of bugs this team has been bitten by before. Stdlib only, no pip deps.

SUBCOMMANDS
  list-apps                                    running GUI apps
  focus       --app NAME                       bring app to foreground
  windows     [--app NAME]                     windows of app (default: frontmost)
  find        --role R [--name N] [--limit L] [--app A] [--window-index I]
                                                query the AX tree: name, value, x/y, w/h, center
  dom         [--app Arc] [--selector CSS] [--limit L]
                                                query the ACTIVE TAB's web page DOM (Arc only);
                                                absolute coords are browser-zoom-normalized;
                                                default selector now also catches cards/options
  fill        SELECTOR VALUE [--name N] [--index K] [--enter] [--app Arc]
              [--await-human S] [--no-verify]  set a web input/textarea's value via the
                                                React-safe native setter (JS-bridge-first,
                                                replaces `type` for web content). Verifies by
                                                reading back; a value the form store accepted
                                                but a validator still rejects surfaces as a
                                                hand-to-human escalation, never a false ok
  select      --value V [--name N] [--selector CSS] [--index K] [--app A]
              [--retries N]                    set a native <select> via JS (.value + change,
                                                no click at all), OR a custom ARIA/react-select
                                                combobox via JS open+poll THEN a REAL cliclick
                                                commit at the option's own rect (dispatched
                                                clicks are ignored by these widgets)
  set-select  ...                              DEPRECATED alias for `select`, one release only
  click       --role R --name N [--index K] [--app A] [--double] [--right]
              | --selector CSS [--name N] [--index K] [--app Arc]
                                                native AX mode: find then AXPress that element.
                                                web mode (--selector): dispatched JS click first,
                                                escalates to a REAL click if state didn't change
  click-xy    X Y [--double] [--right] [--from-view VIEWWIDTH]
                                                click raw screen coords
  type        --text "..." [--enter]           type text at current focus. NATIVE APPS ONLY,
                                                does NOT reach browser web inputs, use `fill`
  key         --key K [--cmd] [--shift] [--option] [--control]
                                                press a key combo
  scroll      --direction up|down [--amount N] approximate scroll (arrow-key presses)
  wait        --role R --name N [--timeout S] [--click] [--app A]
                                                poll locally until element appears
  macro       '<json array of actions>'        run a stop-on-failure action sequence
  screenshot  [outpath] [--display auto|N] [--app A]
                                                FALLBACK: full-screen capture, downsampled;
                                                --display auto resolves --app's actual display;
                                                cursor compositing is always on (screencapture's
                                                -C flag, hardcoded, not a CLI flag of this tool),
                                                always reports its live point numerically too

Every subcommand prints JSON to stdout and exits non-zero with a clear
"error" field on failure (also on stdout, so `python3 -c` one-liners and
shell `| python3 -m json.tool` both work without redirect gymnastics).

HONEST LIMITATIONS
  - `find` walks the Accessibility tree via System Events. It is reliable for
    NATIVE UI: Finder, System Settings, VS Code chrome, Notes, native dialogs,
    and a browser's OWN chrome (Arc's tab bar, sidebar, URL bar). It is NOT
    reliable for the content INSIDE a web page rendered by a browser -- that's
    what `dom` is for (Arc only, via `execute javascript` on the active tab).
  - `dom`'s absolute screen coordinates are DERIVED, not independently
    verified by an actual click (see compute_dom_absolute() below for the
    exact formula and its assumption). Cross-check with `find`/`windows`
    output if a click lands wrong.
  - `dom`'s coordinates are normalized against the page's current browser
    zoom (via window.devicePixelRatio vs NSScreen.backingScaleFactor, see
    dom_query()'s docstring), so a click stays accurate at any zoom level,
    100% or otherwise. Chrome offsets (top/left) are NOT zoom-scaled --
    they're OS-level window chrome, unaffected by page zoom.
  - Native HTML <select>/<option> popups do not accept synthetic clicks or
    keystrokes (the macOS native popup menu ignores injected CGEvents), and
    an OPEN native popup jams the page's JS thread, blocking `dom` entirely
    until dismissed. Use `select` instead, it sets the value via JS and
    never opens the native popup. If a popup does get stuck open (e.g. a
    prior manual click), `execute javascript` calls auto-retry once after
    sending Escape (see JS_EXEC_TIMEOUT_SECONDS / _arc_execute_js()).
  - `scroll` has no real scroll-wheel event available from cliclick 5.1 (it
    was checked: no such command exists). It approximates by sending repeated
    arrow-key presses via System Events, which scrolls most content but is
    not a true wheel-delta event -- some web widgets that specifically listen
    for wheel events may not respond.

COORDINATION -- read before running anything that moves the mouse or sends
keystrokes. See README.md in this directory for the full rule; short version:
if something else is actively driving the desktop, only list-apps / windows /
find / dom (read-only) are safe to run concurrently. focus / click / click-xy
/ type / key / scroll / wait --click / macro all steal focus or inject input.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.abspath(__file__))
AX_JS = os.path.join(HERE, "_ax.js")
KEY_JS = os.path.join(HERE, "_key.js")


def _resolve_cliclick():
    """PATH first (covers both Homebrew prefixes and anything else on
    PATH), then the two well-known Homebrew install locations directly
    (Apple Silicon /opt/homebrew, Intel /usr/local) in case cliclick was
    installed but this shell's PATH doesn't include brew's bin dir yet.
    Falls back to the Apple Silicon path so the resulting error message
    ("cliclick not found at ...") still names a real, useful location.
    """
    found = shutil.which("cliclick")
    if found:
        return found
    for candidate in ("/opt/homebrew/bin/cliclick", "/usr/local/bin/cliclick"):
        if os.access(candidate, os.X_OK):
            return candidate
    return "/opt/homebrew/bin/cliclick"


CLICLICK = _resolve_cliclick()
CALIBRATION_FILE = os.path.join(HERE, ".calibration.json")

# Substrings macOS's Accessibility-permission-denied errors are known to
# contain, from `osascript`/System Events. Checked case-insensitively
# against stderr so run_jxa_ax/run_jxa_key can tell "AX permission missing"
# apart from any other osascript failure and say so in plain language
# instead of surfacing a bare AppleEvent error number.
_AX_DENIED_MARKERS = (
    "not authorized to send apple events",
    "not allowed assistive access",
    "is not allowed to send keystrokes",
    "-1743",
    "(1002)",
)

AX_PERMISSION_HELP = (
    "Accessibility permission is not granted to this terminal app. Every "
    "native-layer command (windows/find/click/type/key/scroll/...) needs "
    "it, and without it the AX tree reads empty and clicks silently do "
    "nothing. Fix: System Settings > Privacy & Security > Accessibility, "
    "enable the terminal app you're running this from (Terminal, iTerm2, "
    "VS Code, etc.). If it's already listed and checked, remove it and "
    "re-add it, macOS sometimes needs that after an app or OS update. "
    "Then re-run this command."
)


def _is_ax_permission_denied(stderr_text):
    lowered = (stderr_text or "").lower()
    return any(marker in lowered for marker in _AX_DENIED_MARKERS)

# Widened for Bug #5 (additive only -- every prior match is still matched):
# platform cards / react-select options were absent from the default `dom`
# output on the live UXCam session, only showing up with an explicit
# --selector, which made targeting them harder than it needed to be.
DEFAULT_DOM_SELECTOR = ("a,button,input,textarea,select,[role=button],[onclick],"
                         "[role=option],[class*=card],[class*=option],li[role]")

# Ceiling for a single `execute javascript` call. Normal calls return in well
# under a second; this only matters when something is genuinely stuck, most
# commonly a native <select>/<option> popup left open (macOS's native popup
# menu runs outside the page's JS event loop and blocks it until dismissed).
# See _arc_execute_js()'s auto-Escape-and-retry-once behavior below.
JS_EXEC_TIMEOUT_SECONDS = 8

# Best-effort guess for Arc's top-chrome height in points, used only until a
# real `calibrate` run has measured it for real. This number came from ONE
# live measurement of (outerHeight - innerHeight) = 52, assumed (not proven)
# to be entirely top chrome. Never trust it for a real click without checking
# `topChromeCalibrated` in `dom`'s output first.
DEFAULT_TOP_CHROME_GUESS = 52

# There is no fixed default-guess constant for left_chrome the way there is
# for top_chrome: the natural pre-calibration guess is whatever
# (outerW - innerW) reports for the CURRENT window (that was this toolkit's
# original, since-proven-wrong assumption for the X axis, kept only as the
# uncalibrated fallback, not trusted). A live `calibrate` run found Arc's
# real left chrome was ~90pt wider than that delta reports (327 modeled vs
# 417 actual), never trust it for a real click without checking
# `leftChromeCalibrated` in `dom`'s output first.


# ---------------------------------------------------------------------------
# low-level helpers
# ---------------------------------------------------------------------------

def die(msg, code=1):
    print(json.dumps({"error": msg}))
    sys.exit(code)


def run_jxa_ax(command, args):
    """Call _ax.js: -> parsed dict.

    AX-permission denial can surface two ways: osascript itself exits
    non-zero (rare, top-level uncaught exception), or _ax.js's own
    try/catch swallows it and returns a normal-looking {"error": "..."}
    on stdout (the common case, since most _ax.js calls wrap the actual
    AX access). Both are checked and rewritten to AX_PERMISSION_HELP so
    the caller gets an actionable fix instead of a bare AppleEvent error
    number (the whole point of this check, an empty AX tree with no
    explanation is the worst first-run experience there is).
    """
    proc = subprocess.run(
        ["osascript", "-l", "JavaScript", AX_JS, command, json.dumps(args)],
        capture_output=True, text=True,
    )
    if proc.returncode != 0:
        stderr = (proc.stderr or "").strip()
        if _is_ax_permission_denied(stderr):
            return {"error": AX_PERMISSION_HELP, "detail": stderr}
        return {"error": "osascript failed: " + stderr}
    try:
        out = json.loads(proc.stdout.strip())
    except ValueError:
        return {"error": "could not parse AX output: " + proc.stdout[:300]}
    if isinstance(out, dict) and _is_ax_permission_denied(out.get("error", "")):
        return {"error": AX_PERMISSION_HELP, "detail": out.get("error")}
    return out


def run_jxa_key(key, mods):
    args = {"key": key}
    args.update(mods)
    proc = subprocess.run(
        ["osascript", "-l", "JavaScript", KEY_JS, json.dumps(args)],
        capture_output=True, text=True,
    )
    if proc.returncode != 0:
        stderr = (proc.stderr or "").strip()
        if _is_ax_permission_denied(stderr):
            return {"error": AX_PERMISSION_HELP, "detail": stderr}
        return {"error": "osascript failed: " + stderr}
    try:
        out = json.loads(proc.stdout.strip())
    except ValueError:
        return {"error": "could not parse key output: " + proc.stdout[:300]}
    if isinstance(out, dict) and _is_ax_permission_denied(out.get("error", "")):
        return {"error": AX_PERMISSION_HELP, "detail": out.get("error")}
    return out


def cliclick(*cmds):
    if not os.access(CLICLICK, os.X_OK):
        return {"error": "cliclick not found at " + CLICLICK + " (brew install cliclick)"}
    proc = subprocess.run([CLICLICK] + list(cmds), capture_output=True, text=True)
    if proc.returncode != 0:
        return {"error": "cliclick failed: " + (proc.stderr or "").strip()}
    return {"ok": True}


def _cliclick_cursor_position():
    """Live cursor point (screen points, quartz/AX space), via cliclick's
    own `p:.` (print-position, no move). None on any failure -- never guess
    a stale/zero point."""
    if not os.access(CLICLICK, os.X_OK):
        return None
    proc = subprocess.run([CLICLICK, "p:."], capture_output=True, text=True)
    if proc.returncode != 0:
        return None
    parts = proc.stdout.strip().split(",")
    if len(parts) != 2:
        return None
    try:
        return {"x": int(parts[0]), "y": int(parts[1])}
    except ValueError:
        return None


def screen_width_points(display_index=None):
    """
    Live-query the width (in points) of a display. NEVER guess a fallback
    number here, a wrong guess silently mis-scales every --from-view click.
    On any query failure this hard-fails the whole command instead.

    display_index: None or 0 means the main display (NSScreen.mainScreen,
    always correct). A positive index (1-based, matching screencapture's -D
    numbering) is a best-effort lookup into NSScreen.screens, see the
    caveat on that ordering in cmd_screenshot / README.
    """
    ax_args = {}
    if display_index:
        ax_args["index"] = display_index - 1  # screencapture -D is 1-based
    info = run_jxa_ax("screen", ax_args)
    if "error" in info or "widthPoints" not in info:
        die("could not query screen width for --from-view scaling: " + str(info.get("error", info)))
    return info["widthPoints"]


def _viewport_to_screen(ax_frame, top_chrome, left_chrome, zoom_factor, vx, vy):
    """
    The one formula every absolute-coordinate consumer (dom reads AND the
    real-click escalation primitive) must share, so a reader and a clicker
    can never drift apart:
      absX = axWindowX + left_chrome + round(vx * zoom_factor)
      absY = axWindowY + top_chrome  + round(vy * zoom_factor)

    ax_frame is the AX-reported window frame (x/y from `windows --app
    <browser>`, i.e. System Events' own position() for the real window) --
    the SINGLE ground truth for window origin (Fix #1, Asclepius QA finding).
    window.screenX/window.screenY (the JS self-report) must NEVER be used
    here: under a hardware-mirrored display configuration (built-in panel
    mirroring an external ultrawide), Chromium reports screenX/screenY as
    (0,0) and outerWidth/outerHeight as the full MIRRORED DISPLAY size
    (e.g. 3440x1440) instead of the real window frame (e.g. 20,20,1519x1063
    per AX) -- every absolute point computed off the JS numbers misses the
    visible window entirely. AX's position()/size() are unaffected by
    mirroring since they come from the window server, not the page's view
    of its own screen. Returns (abs_x, abs_y) as ints.
    """
    abs_x = ax_frame["x"] + left_chrome + round(vx * zoom_factor)
    abs_y = ax_frame["y"] + top_chrome + round(vy * zoom_factor)
    return int(abs_x), int(abs_y)


def _is_app_running(app_name):
    apps = run_jxa_ax("list-apps", {})
    if not isinstance(apps, list):
        return False
    return any(a.get("name") == app_name for a in apps)


# Belt-and-suspenders guard for Fix #1: this NEVER changes which numbers get
# used for positioning (ax_frame always wins, see _viewport_to_screen), it
# only cross-checks the JS self-report against AX so a caller/log can see
# the corrupted-JS-geometry case explicitly instead of silently trusting
# numbers that happen to be wrong. Generous tolerance -- window-manager
# rounding/inset differences of a few px are normal and not the failure
# mode this guards against (a whole-display-sized mismatch is).
GEOMETRY_AGREEMENT_TOLERANCE_PX = 15


def _check_js_geometry_against_ax(win_metrics, ax_frame):
    """
    Compares window.screenX/screenY/outerWidth/outerHeight (JS self-report)
    against the AX-reported window frame (System Events position/size, the
    single ground truth -- see _viewport_to_screen). Returns
    (agrees: bool|None, detail: dict). agrees is None only when either side
    couldn't be read at all (nothing to compare); detail always carries both
    raw readings when available for logging/debugging.
    """
    if not win_metrics or not ax_frame:
        return None, {"reason": "missing-metrics", "haveWinMetrics": bool(win_metrics),
                       "haveAxFrame": bool(ax_frame)}
    js_x, js_y = win_metrics.get("screenX"), win_metrics.get("screenY")
    js_w, js_h = win_metrics.get("outerW"), win_metrics.get("outerH")
    ax_x, ax_y, ax_w, ax_h = ax_frame.get("x"), ax_frame.get("y"), ax_frame.get("w"), ax_frame.get("h")
    if None in (js_x, js_y, js_w, js_h, ax_x, ax_y, ax_w, ax_h):
        return None, {"reason": "incomplete-metrics"}
    agrees = (abs(js_x - ax_x) <= GEOMETRY_AGREEMENT_TOLERANCE_PX
              and abs(js_y - ax_y) <= GEOMETRY_AGREEMENT_TOLERANCE_PX
              and abs(js_w - ax_w) <= GEOMETRY_AGREEMENT_TOLERANCE_PX
              and abs(js_h - ax_h) <= GEOMETRY_AGREEMENT_TOLERANCE_PX)
    return agrees, {
        "js": {"x": js_x, "y": js_y, "w": js_w, "h": js_h},
        "ax": {"x": ax_x, "y": ax_y, "w": ax_w, "h": ax_h},
    }


# ---------------------------------------------------------------------------
# top/left-chrome calibration store (.calibration.json (next to this script))
#
# `dom`'s absolute-coordinate formula needs to know how tall/wide Arc's
# chrome is, in points, above/beside the page viewport, on BOTH axes:
#   absScreenY = windowY + top_chrome  + viewportY
#   absScreenX = windowX + left_chrome + viewportX
# Neither number can be safely derived from window.outerWidth/outerHeight -
# window.innerWidth/innerHeight alone: a live `calibrate` run proved BOTH of
# this toolkit's original assumptions wrong.
#   - outerH - innerH is TOP chrome + BOTTOM chrome combined (assuming it's
#     all top chrome put a click a bar-height too low, fixed in an earlier
#     revision with top_chrome).
#   - outerW - innerW is NOT Arc's real left-sidebar width either: a live
#     run found the model value (327) undershot the real left chrome (417)
#     by ~90pt, Arc's actual chrome is wider than the outer/inner window
#     delta reports (there is presumably some non-viewport, non-chrome
#     padding/inset the delta doesn't account for).
# So both top_chrome and left_chrome are resolved the same way: an explicit
# --top-chrome/--left-chrome override, a previously `calibrate`-measured
# value (this file), or a clearly-marked UNCALIBRATED default guess. Never
# silently trust a stored value if the window's chrome delta on that AXIS
# has changed since it was measured (resize, fullscreen toggle, sidebar
# collapse can all change chrome height and/or width independently) -- see
# get_top_chrome() / get_left_chrome().
#
# BUG (found 2026-09-01, cost two multi-hour incidents): the chrome-delta
# signature above is (ax_frame h/w) minus (JS innerH/innerW). That delta is
# the height/width of Arc's FIXED chrome elements (toolbar, tab strip,
# sidebar) -- it does NOT scale with the window's own size or move with the
# window's origin, so resizing, moving, or fullscreening the window all
# leave it completely unchanged UNLESS the chrome itself restructures (a
# sidebar collapse does restructure it, and IS caught -- confirmed live: it
# moved the width delta from 327 to 20). Measured live across windowed,
# moved, and fullscreen geometries on 2026-09-01: the delta stayed exactly
# 52/327 in all three, so "config-stale" never fired in any of them, exactly
# matching the reported symptom (topChromeStale/leftChromeStale both False
# in fullscreen). A live `calibrate` run in each of those three geometries
# also came back with deltaX/deltaY of 0 every time here -- meaning on this
# Arc build, fullscreen did NOT actually move the true offset, so the two
# real incidents were not reproduced by "fullscreen changes the chrome
# math" as such. But AXFullScreen is a real, directly-readable, high-
# consequence state change the resolver had ZERO visibility into -- it was
# only ever inferred through the delta proxy, which can't see it by
# construction. Both real incidents happened with a calibration recorded
# windowed and read back in fullscreen, so this file and the resolvers now
# also record/compare AXFullScreen directly (fullScreenAtCalibration below),
# independent of the delta check, biased toward firing stale on any
# mismatch -- see the "config-stale-fullscreen" source in get_top_chrome()/
# get_left_chrome().
# ---------------------------------------------------------------------------

def load_calibration():
    if not os.path.exists(CALIBRATION_FILE):
        return {}
    try:
        with open(CALIBRATION_FILE) as f:
            return json.load(f)
    except (ValueError, OSError):
        return {}


def save_calibration(browser, top_chrome, left_chrome, ax_frame, win_metrics,
                      display_index=None, backing_scale=None):
    """
    ax_frame is the AX-reported window frame (Fix #1 ground truth, see
    _viewport_to_screen); win_metrics is the JS self-report, used here only
    for innerW/innerH (viewport size, unaffected by the mirrored-display
    corruption) and dpr. The staleness signatures below are the AX frame's
    w/h minus the JS viewport's innerW/innerH -- NOT window.outerWidth/
    outerHeight, which misreport the full mirrored display's size under
    a hardware-mirrored multi-display setup and would make every staleness check
    meaningless (outerW/outerH don't change when the real window resizes).
    """
    data = load_calibration()
    data[browser.lower()] = {
        "topChrome": top_chrome,
        "leftChrome": left_chrome,
        "calibratedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        # staleness signatures, per axis: if EITHER delta differs at read
        # time, that axis's calibration no longer applies and must be redone
        # (the two can go stale independently, e.g. a sidebar collapse
        # changes width but not height).
        "chromeHeightDeltaAtCalibration": ax_frame["h"] - win_metrics["innerH"],
        "chromeWidthDeltaAtCalibration": ax_frame["w"] - win_metrics["innerW"],
        "outerHAtCalibration": ax_frame["h"],
        "innerHAtCalibration": win_metrics["innerH"],
        "outerWAtCalibration": ax_frame["w"],
        "innerWAtCalibration": win_metrics["innerW"],
        # display-aware staleness (Bug #3): a calibration measured on one
        # display is meaningless on another, and can't be caught by the
        # chrome-delta signature alone (a window dragged between two
        # displays of the SAME chrome height/width would pass that check
        # and still be wrong, e.g. different backing scale).
        "displayIndexAtCalibration": display_index,
        "backingScaleAtCalibration": backing_scale,
        # AXFullScreen at calibration time (None if it couldn't be read),
        # compared live in get_top_chrome/get_left_chrome -- the chrome-
        # delta signature above cannot see a fullscreen toggle by
        # construction (see the BUG note above this function), so this is
        # an independent, directly-observed signal for the exact state
        # both real 2026-09-01 incidents happened in.
        "fullScreenAtCalibration": ax_frame.get("fullScreen"),
    }
    with open(CALIBRATION_FILE, "w") as f:
        json.dump(data, f, indent=2)


def get_top_chrome(browser, ax_frame, win_metrics, cli_override, display_index=None, backing_scale=None):
    """
    Returns (value, calibrated: bool, source: str, stale: bool).

    Precedence: explicit --top-chrome flag > a still-valid stored
    calibration > an UNCALIBRATED default guess. A stored calibration is
    considered valid only if (a) the window's current vertical chrome delta
    (ax_frame's h - JS innerH) matches the delta recorded at calibration
    time, AND (b) the window is still on the same display with the same
    backing scale it was calibrated on -- Arc's chrome can happen to measure
    the same delta on two different displays and still be wrong (source is
    then "config-stale-display", not the generic "config-stale", so a caller
    can tell "chrome changed" apart from "you moved screens" if it matters).
    display_index/backing_scale are best-effort (from resolve_window_display
    or _screen_backing_scale_factor); when unavailable this check is skipped
    and only the chrome-delta signature applies, same as before this fix.

    ax_frame (the AX window frame, Fix #1 ground truth) supplies h;
    window.outerHeight is NEVER used for this delta -- under a hardware-
    mirrored display it reports the full mirrored display's height, not the
    real window's, which would make the staleness signature meaningless.
    """
    if cli_override is not None:
        return cli_override, True, "cli-flag", False

    data = load_calibration()
    entry = data.get(browser.lower())
    if entry and ax_frame and win_metrics and "topChrome" in entry:
        stored_display = entry.get("displayIndexAtCalibration")
        stored_scale = entry.get("backingScaleAtCalibration")
        display_moved = (display_index is not None and stored_display is not None
                          and display_index != stored_display)
        scale_changed = (backing_scale is not None and stored_scale is not None
                          and backing_scale != stored_scale)
        if display_moved or scale_changed:
            return DEFAULT_TOP_CHROME_GUESS, False, "config-stale-display", True
        # AXFullScreen mismatch, independent of the delta check below (see
        # the BUG note above save_calibration -- the delta is provably
        # blind to a fullscreen toggle by construction, confirmed live on
        # 2026-09-01, so this is checked directly rather than inferred).
        # Both sides None (older calibration file, or AX read failed) skips
        # this check rather than guessing, same convention as display/scale.
        stored_fullscreen = entry.get("fullScreenAtCalibration")
        current_fullscreen = ax_frame.get("fullScreen")
        if stored_fullscreen is not None and current_fullscreen is not None \
                and stored_fullscreen != current_fullscreen:
            return DEFAULT_TOP_CHROME_GUESS, False, "config-stale-fullscreen", True
        current_delta = ax_frame["h"] - win_metrics["innerH"]
        stored_delta = entry.get("chromeHeightDeltaAtCalibration")
        if stored_delta == current_delta:
            return entry["topChrome"], True, "config", False
        return DEFAULT_TOP_CHROME_GUESS, False, "config-stale", True

    return DEFAULT_TOP_CHROME_GUESS, False, "default-guess", False


def get_left_chrome(browser, ax_frame, win_metrics, cli_override, display_index=None, backing_scale=None):
    """
    Returns (value, calibrated: bool, source: str, stale: bool). Mirrors
    get_top_chrome() exactly, on the X axis (including the display/backing-
    scale staleness check, "config-stale-display"). There is no fixed
    default-guess constant here (unlike DEFAULT_TOP_CHROME_GUESS): the
    uncalibrated fallback is (ax_frame's w - JS innerW) for the CURRENT
    window -- ax_frame (Fix #1 ground truth) supplies w; window.outerWidth
    is NEVER used here, same reasoning as get_top_chrome (mirrored-display
    corruption makes it report the full mirrored display's width).
    """
    default_guess = (ax_frame["w"] - win_metrics["innerW"]) if (ax_frame and win_metrics) else 0

    if cli_override is not None:
        return cli_override, True, "cli-flag", False

    data = load_calibration()
    entry = data.get(browser.lower())
    if entry and ax_frame and win_metrics and "leftChrome" in entry:
        stored_display = entry.get("displayIndexAtCalibration")
        stored_scale = entry.get("backingScaleAtCalibration")
        display_moved = (display_index is not None and stored_display is not None
                          and display_index != stored_display)
        scale_changed = (backing_scale is not None and stored_scale is not None
                          and backing_scale != stored_scale)
        if display_moved or scale_changed:
            return default_guess, False, "config-stale-display", True
        # See get_top_chrome()'s matching check -- same reasoning, mirrored.
        stored_fullscreen = entry.get("fullScreenAtCalibration")
        current_fullscreen = ax_frame.get("fullScreen")
        if stored_fullscreen is not None and current_fullscreen is not None \
                and stored_fullscreen != current_fullscreen:
            return default_guess, False, "config-stale-fullscreen", True
        current_delta = ax_frame["w"] - win_metrics["innerW"]
        stored_delta = entry.get("chromeWidthDeltaAtCalibration")
        if stored_delta == current_delta:
            return entry["leftChrome"], True, "config", False
        return default_guess, False, "config-stale", True

    return default_guess, False, "default-guess", False


