# ---------------------------------------------------------------------------
# dom: query the active tab's web page in Arc via `execute javascript`
# ---------------------------------------------------------------------------

def _osascript_string_literal(js):
    """Escape a JS payload for embedding inside an AppleScript double-quoted string."""
    return js.replace("\\", "\\\\").replace('"', '\\"')


def _arc_execute_js(js, browser="Arc", _allow_retry=True):
    """
    Run `js` in the active tab's page context, return (ok, raw_stdout, stderr).

    Bounded by JS_EXEC_TIMEOUT_SECONDS. A native macOS popup menu (most
    commonly an open <select>/<option> dropdown, but also e.g. a native
    autofill suggestion list) runs OUTSIDE the page's JS event loop and
    BLOCKS it entirely while open -- `execute javascript` hangs until the
    popup is dismissed. System Events keystrokes, unlike page JS, are
    OS-level and still get delivered while the page is jammed, so on a
    timeout this sends Escape (dismisses any open native popup/menu without
    touching the mouse) and retries ONCE. A second timeout after the retry
    is reported as a real error rather than looping forever.
    """
    literal = _osascript_string_literal(js)
    script = (
        'tell application "%s" to tell front window\'s active tab to execute javascript "%s"'
        % (browser, literal)
    )
    try:
        proc = subprocess.run(["osascript", "-e", script], capture_output=True, text=True,
                               timeout=JS_EXEC_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        if _allow_retry:
            run_jxa_key("escape", {})
            time.sleep(0.3)
            return _arc_execute_js(js, browser, _allow_retry=False)
        return False, "", ("execute javascript timed out after %ss, twice in a row (sent Escape "
                            "and retried once already) -- likely a native popup that Escape could "
                            "not clear, or a genuinely hung page" % JS_EXEC_TIMEOUT_SECONDS)
    return proc.returncode == 0, proc.stdout.strip(), proc.stderr.strip()


def _arc_window_geometry(browser="Arc"):
    win = run_jxa_ax("windows", {"app": browser})
    if "error" in win or not win.get("windows"):
        return None
    # frontmost/content window: pick the widest one (Arc sometimes reports a
    # slim companion window for its sidebar-collapse handle)
    windows = sorted(win["windows"], key=lambda w: (w.get("w") or 0), reverse=True)
    return windows[0]


def _dom_element_extract_js(selector, limit, include_pointer_scan=False):
    """
    include_pointer_scan (Bug #5, additive-only): ALSO includes any
    div/span/li/a with computed `cursor:pointer` that the CSS `selector`
    didn't already match -- a plain `<div onclick-via-addEventListener>`
    styled-component card has no attribute a CSS selector can catch, cursor
    is the only observable signal. Bounded (first 800 candidates scanned)
    to keep it cheap on a large page; only wired on when the CALLER is
    using the default selector (see dom_query), never on an explicit
    narrow --selector, so a caller asking for something specific doesn't
    get surprise extra rows.
    """
    base = (
        "Array.from(document.querySelectorAll(%s))"
        ".map(function(el){var r=el.getBoundingClientRect();"
        "return {el:el,tag:el.tagName,"
        "text:(el.innerText||el.value||el.placeholder||'').trim().slice(0,80),"
        "x:Math.round(r.x+r.width/2),y:Math.round(r.y+r.height/2),"
        "w:Math.round(r.width),h:Math.round(r.height)};})"
    ) % json.dumps(selector)
    if include_pointer_scan:
        pointer_scan = (
            "Array.from(document.querySelectorAll('div,span,li,a')).slice(0,800)"
            ".filter(function(el){try{return window.getComputedStyle(el).cursor==='pointer';}"
            "catch(e){return false;}})"
            ".map(function(el){var r=el.getBoundingClientRect();"
            "return {el:el,tag:el.tagName,"
            "text:(el.innerText||el.value||el.placeholder||'').trim().slice(0,80),"
            "x:Math.round(r.x+r.width/2),y:Math.round(r.y+r.height/2),"
            "w:Math.round(r.width),h:Math.round(r.height)};})"
        )
        combined = (
            "(function(){var seen=new Set();var primary=%s;"
            "primary.forEach(function(e){seen.add(e.el);});"
            "var extra=%s.filter(function(e){return !seen.has(e.el);});"
            "return primary.concat(extra);})()"
        ) % (base, pointer_scan)
    else:
        combined = base
    return (
        "JSON.stringify(%s"
        ".map(function(e){return {tag:e.tag,text:e.text,x:e.x,y:e.y,w:e.w,h:e.h};})"
        ".filter(function(e){return e.w>0&&e.h>0;}).slice(0,%d))"
    ) % (combined, limit)


CLIPBOARD_RELAY_SENTINEL = "DESKTOP_AX_DOM_V1:"


def _clipboard_read_text():
    """Best-effort read of the current clipboard as text; None if not text."""
    r = subprocess.run(["osascript", "-e", "the clipboard as text"],
                        capture_output=True, text=True)
    if r.returncode != 0:
        return None
    return r.stdout[:-1] if r.stdout.endswith("\n") else r.stdout


def _clipboard_write_text(text):
    literal = text.replace("\\", "\\\\").replace('"', '\\"')
    subprocess.run(["osascript", "-e", 'set the clipboard to "%s"' % literal],
                    capture_output=True, text=True)


def _dom_via_clipboard_relay(selector, limit, browser):
    """
    Fallback path when `execute javascript`'s direct return is empty: have
    the page write its JSON into a hidden textarea, copy it, and read it
    back from the system clipboard. This CLOBBERS whatever the user last
    copied, so it saves the prior clipboard first and restores it after
    (best-effort: if the prior clipboard held something non-text, e.g. an
    image, it can't be round-tripped through `the clipboard as text` and is
    left as-is rather than destroyed with a wrong value).

    A sentinel prefix is written along with the payload and checked on
    read, if it's missing, either the copy silently failed or something
    else raced onto the clipboard between the write and the read, and this
    returns an error instead of trying to parse stale/foreign clipboard
    content as coordinates.
    """
    prior_clipboard = _clipboard_read_text()

    inner = _dom_element_extract_js(selector, limit)
    relay_js = (
        "(function(){var ta=document.createElement('textarea');"
        "ta.value=%s+(%s);document.body.appendChild(ta);ta.select();"
        "document.execCommand('copy');document.body.removeChild(ta);return true;})()"
    ) % (json.dumps(CLIPBOARD_RELAY_SENTINEL), inner)

    ok, _out, err = _arc_execute_js(relay_js, browser)
    if not ok:
        return None, {"error": "clipboard relay javascript failed: " + err}

    clip_text = _clipboard_read_text()

    if prior_clipboard is not None:
        _clipboard_write_text(prior_clipboard)
    # if prior_clipboard was None (non-text or empty), leave the clipboard
    # as-is rather than guess a restore value.

    if clip_text is None or not clip_text.startswith(CLIPBOARD_RELAY_SENTINEL):
        return None, {"error": "clipboard relay verification failed (sentinel missing, "
                                "stale or foreign clipboard content)"}

    return clip_text[len(CLIPBOARD_RELAY_SENTINEL):], None


def _screen_backing_scale_factor(ax_frame=None):
    """
    The OS-level Retina backing scale factor (1.0 on a non-retina display,
    2.0 on a retina one) of the screen that ACTUALLY CONTAINS the browser
    window, completely independent of any browser's page zoom. This is the
    baseline `dom`'s zoom-normalization divides window.devicePixelRatio by
    (see dom_query()'s docstring).

    MULTI-MONITOR CORRECTNESS (P2 fix): this used to unconditionally read
    NSScreen.mainScreen's backingScaleFactor. On a setup running a retina
    built-in panel (2x) alongside a 1x external display simultaneously
    (a retina built-in plus a 1x external), that's only correct when the browser window
    happens to be on whichever display macOS currently calls "main" -- if
    Arc's window is on the OTHER display, mainScreen's scale is wrong by a
    factor of 2x/0.5x, EVEN AT 100% ZOOM, and every derived `dom` coordinate
    is off by the same factor despite a perfectly good calibration.

    Fix: pass the window's own center point (in quartz/AX screen space --
    origin top-left of the primary display, y increasing downward, same
    space AX window positions use) to _ax.js's `screen` command, which
    finds which NSScreen.screens entry's frame actually contains that point
    and returns THAT screen's backing scale.

    ax_frame is the AX-reported window frame (Fix #1 ground truth, see
    _viewport_to_screen) -- window.screenX/screenY/outerWidth/outerHeight
    are NEVER used for this center point: under a hardware-mirrored display
    they report (0,0) plus the full mirrored display's size, which would
    resolve to the wrong screen (or the right screen for the wrong reason)
    on exactly the setup this fix targets.

    Returns (backing_scale, trustworthy, screen_index):
      - backing_scale: the resolved factor, or None if the query failed
        outright (caller should skip zoom-normalization rather than divide
        by a guess, same as before this fix).
      - trustworthy: True only when a screen was matched by genuinely
        containing the window's position. False when there was no window
        point to test (ax_frame missing) or the point matched no screen
        (fell back to mainScreen as a last resort but can't vouch for it).
        Per Codex review: a mis-identified screen is worse than skipping
        zoom scaling, so callers MUST treat zoom_factor as untrustworthy
        (fall back to 1.0, i.e. no scaling) rather than apply a guessed
        scale, whenever this is False.
      - screen_index: NSScreen.screens index that was matched/used, or
        None if no lookup was possible (query failure).
    """
    at_args = {}
    if ax_frame and ax_frame.get("x") is not None and ax_frame.get("y") is not None:
        at_args = {
            "atX": ax_frame["x"] + (ax_frame.get("w") or 0) / 2.0,
            "atY": ax_frame["y"] + (ax_frame.get("h") or 0) / 2.0,
        }
    info = run_jxa_ax("screen", at_args)
    if not isinstance(info, dict) or "backingScaleFactor" not in info or not info["backingScaleFactor"]:
        return None, False, None
    return info["backingScaleFactor"], bool(info.get("trustworthy")), info.get("screenIndex")


def resolve_window_display(browser):
    """
    Generalizes _screen_backing_scale_factor() into the full display-aware
    picture the real-click escalation primitive and the display-aware
    calibration signature both need: WHICH display the browser window
    actually sits on, that display's full frame (in quartz/AX point space,
    same space cliclick/window.screenX all use), and whether the lookup is
    trustworthy (see _screen_backing_scale_factor's docstring -- a
    mis-identified screen is worse than not knowing, callers must not guess
    on untrustworthy=False).

    Returns None if the window frame can't be read at all (browser not
    running / no window). Never assumes display 1 -- always resolves by the
    window's own center point, taken from the AX frame (Fix #1 ground
    truth), NEVER from window.screenX/screenY/outerWidth/outerHeight (the JS
    self-report, which misreports the full mirrored display's origin/size
    under a hardware-mirrored multi-display setup).
    """
    ax_frame = _arc_window_geometry(browser)
    if not ax_frame:
        return None
    at_args = {
        "atX": ax_frame["x"] + (ax_frame.get("w") or 0) / 2.0,
        "atY": ax_frame["y"] + (ax_frame.get("h") or 0) / 2.0,
    }
    info = run_jxa_ax("screen", at_args)
    if not isinstance(info, dict) or "widthPoints" not in info:
        return None
    return {
        "screenIndex": info.get("screenIndex"),
        "originXQuartz": info.get("originXQuartz"),
        "originYQuartz": info.get("originYQuartz"),
        "widthPoints": info.get("widthPoints"),
        "heightPoints": info.get("heightPoints"),
        "backingScale": info.get("backingScaleFactor"),
        "trustworthy": bool(info.get("trustworthy")),
        "windowX": ax_frame["x"], "windowY": ax_frame["y"],
        "windowW": ax_frame.get("w"), "windowH": ax_frame.get("h"),
    }


def _dom_window_metrics(browser):
    win_info_js = (
        "JSON.stringify({outerW:window.outerWidth,outerH:window.outerHeight,"
        "innerW:window.innerWidth,innerH:window.innerHeight,"
        "screenX:window.screenX,screenY:window.screenY,dpr:window.devicePixelRatio})"
    )
    ok, winout, _ = _arc_execute_js(win_info_js, browser)
    if not ok:
        return None
    try:
        return json.loads(json.loads(winout) if winout.startswith('"') else winout)
    except ValueError:
        return None


def dom_query(browser, selector, limit, top_chrome_override=None, left_chrome_override=None):
    """
    Extract visible interactive elements from the active tab's DOM.

    Returns dict with:
      - elements: list of {tag, text, vx, vy, vw, vh (viewport-relative),
                            x, y (ABSOLUTE SCREEN coords, best-effort)}
      - windowMetrics / windowGeometry: the raw numbers used to derive
        absolute coords, so a caller can sanity-check or recompute.
      - topChrome / topChromeCalibrated / topChromeSource / topChromeStale:
        see get_top_chrome().
      - leftChrome / leftChromeCalibrated / leftChromeSource / leftChromeStale:
        see get_left_chrome().

    ABSOLUTE COORDINATE DERIVATION:
      window.screenX/screenY (JS) matches the AX window position exactly (both
      are in the same point space on this 1x display -- verified live: Arc's
      AX window position was x=1351,y=0 and JS window.screenX/screenY was also
      1351,0).

      Both axes now work IDENTICALLY, each via its own single calibrated
      offset rather than the outerW/innerW or outerH/innerH deltas:
        absScreenX = windowX + left_chrome + viewportX
        absScreenY = windowY + top_chrome  + viewportY

      This function originally used (outerW - innerW) directly as the X
      offset (assuming Arc's whole left sidebar width equals that delta) and
      (outerH - innerH) directly as the Y offset (assuming that whole delta
      is top chrome). A live `calibrate` run proved BOTH assumptions wrong:
      Y clicks landed a bar-height too low (fixed by top_chrome in an
      earlier revision), and once that was live-tested, X clicks landed
      ~90pt too far right (modeled left chrome 327 vs real 417), the
      outerW-innerW delta undershoots Arc's real chrome width. `left_chrome`
      is now resolved by get_left_chrome() exactly like `top_chrome` is by
      get_top_chrome(): an explicit --left-chrome override, a previously
      `calibrate`-measured value from .calibration.json (only if the
      window's WIDTH chrome delta hasn't changed since), or an UNCALIBRATED
      default guess (that same outerW-innerW delta, now clearly marked as
      not to be trusted). Always check `topChromeCalibrated` AND
      `leftChromeCalibrated` before trusting a derived point for anything
      that matters. Run `calibrate` once the desktop is free to measure both
      for real, it corrects both axes from a single click.

    ZOOM NORMALIZATION:
      getBoundingClientRect() (what el.x/el.y come from) returns coordinates
      in the page's CSS-pixel LAYOUT VIEWPORT, which Chromium rescales at
      any browser zoom level other than 100% -- at 110% zoom the same
      physical window shows FEWER CSS px (innerWidth shrinks), so a CSS-px
      viewport offset needs to be scaled UP to reach the right PHYSICAL
      screen point, while `top_chrome`/`left_chrome` (real OS window chrome,
      set once by `calibrate`) do NOT scale with page zoom at all.

      The scale factor is window.devicePixelRatio (captured in
      windowMetrics.dpr) divided by NSScreen.backingScaleFactor (queried
      live via _screen_backing_scale_factor(), NOT hardcoded): Chromium
      reports dpr = deviceScaleFactor * zoomLevel, so dividing out the
      OS-level deviceScaleFactor isolates the zoom-only component. Verified
      live on this 1x/non-retina display: at 100% zoom dpr=1 and
      backingScaleFactor=1 -> zoomFactor=1 (and a live mousemove-readback
      test confirmed the resulting absolute point lands exactly on target,
      0px error, at that zoom level); at 110% zoom (Cmd+=) dpr measured
      1.100000023841858 with backingScaleFactor still 1 -> zoomFactor=1.1,
      matching Chromium's documented dpr=deviceScale*zoom behavior exactly.
      On a retina display backingScaleFactor would read 2,
      so 100%-zoom dpr=2 -> zoomFactor=1 there too, and 110% zoom would
      report dpr=2.2 -> zoomFactor=1.1 again, same formula, no per-display
      special-casing needed.

      absScreenX = windowX + left_chrome + viewportX * zoomFactor
      absScreenY = windowY + top_chrome  + viewportY * zoomFactor

      `zoomFactor`/`browserDpr`/`backingScaleFactor` are included in the
      result for debugging. If the backing-scale query fails, zoomFactor
      falls back to 1.0 (unscaled) rather than guessing.

      MULTI-MONITOR: `backingScaleFactor` is read from whichever display
      the browser window's own center point actually falls on (see
      _screen_backing_scale_factor()), not NSScreen.mainScreen -- a
      retina built-in used alongside a 1x external otherwise mis-scales
      zoomFactor by 2x/0.5x when the window is on the non-main display.
      `zoomScaleTrustworthy` and `backingScaleScreenIndex` are included in
      the result: if the window-containing screen could not be determined,
      `zoomFactor` is forced to 1.0 (no scaling applied) rather than risk
      using the wrong screen's scale.
    """
    if not _is_app_running(browser):
        return {"error": "%s is not running -- dom will not auto-launch a browser, "
                          "open it first" % browser}

    # Only add the cursor:pointer pass when the caller is using the (now
    # widened) default selector -- an explicit --selector is a deliberate
    # narrowing, honor it as-is (see _dom_element_extract_js docstring).
    js = _dom_element_extract_js(selector, limit, include_pointer_scan=(selector == DEFAULT_DOM_SELECTOR))
    ok, out, err = _arc_execute_js(js, browser)
    used_clipboard = False

    if not ok or not out or out in ("missing value", ""):
        out, relay_err = _dom_via_clipboard_relay(selector, limit, browser)
        if relay_err:
            combined = dict(relay_err)
            combined["error"] = "execute javascript failed (direct: %s; %s)" % (err, relay_err["error"])
            return combined
        used_clipboard = True

    # AppleScript prints a JSON string as a quoted, escaped literal -- that
    # literal is itself valid JSON for a string, so decode twice.
    try:
        inner_json_str = json.loads(out) if out.startswith('"') else out
        elements = json.loads(inner_json_str)
    except ValueError as e:
        return {"error": "could not parse DOM JSON: %s (raw: %s)" % (e, out[:300])}

    # ax_frame (the AX-reported window frame) is the SINGLE ground truth for
    # window origin/size (Fix #1) -- win_metrics (the JS self-report) is
    # kept only for innerW/innerH (viewport size) and dpr, NEVER for
    # screenX/screenY/outerW/outerH, which misreport the full mirrored
    # display's origin/size under a hardware-mirrored multi-display setup.
    ax_frame = _arc_window_geometry(browser)
    win_metrics = _dom_window_metrics(browser)
    geometry_agrees, geometry_detail = _check_js_geometry_against_ax(win_metrics, ax_frame)
    if geometry_agrees is False:
        # Never fall back to the JS numbers silently -- ax_frame is already
        # what's used below regardless, this is purely so a caller/log can
        # see the corrupted-JS-geometry case explicitly.
        geometry_detail = dict(geometry_detail)
        geometry_detail["note"] = ("window.screenX/screenY/outerWidth/outerHeight disagree with "
                                    "the AX window frame beyond tolerance -- JS self-report "
                                    "REJECTED, using AX frame as ground truth (Fix #1)")

    # Zoom normalization + display resolution share one AX "screen" lookup
    # (_screen_backing_scale_factor), so it's resolved BEFORE top/left chrome
    # -- both the zoomFactor below and the calibration display/backing-scale
    # staleness check (get_top_chrome/get_left_chrome) need it.
    backing_scale, zoom_scale_trustworthy, backing_scale_screen_index = \
        _screen_backing_scale_factor(ax_frame)
    # Only feed a screen_index/backing_scale into the calibration staleness
    # check when the lookup is actually trustworthy -- an untrustworthy
    # guess would otherwise force every calibration stale for the wrong
    # reason.
    display_index_for_staleness = backing_scale_screen_index if zoom_scale_trustworthy else None
    backing_scale_for_staleness = backing_scale if zoom_scale_trustworthy else None

    top_chrome, top_chrome_calibrated, top_chrome_source, top_chrome_stale = \
        get_top_chrome(browser, ax_frame, win_metrics, top_chrome_override,
                       display_index_for_staleness, backing_scale_for_staleness)
    left_chrome, left_chrome_calibrated, left_chrome_source, left_chrome_stale = \
        get_left_chrome(browser, ax_frame, win_metrics, left_chrome_override,
                        display_index_for_staleness, backing_scale_for_staleness)

    # Zoom normalization: getBoundingClientRect() coordinates are in the
    # page's CSS-pixel layout viewport, which Chromium rescales at any page
    # zoom other than 100%. window.devicePixelRatio / NSScreen.
    # backingScaleFactor isolates the zoom-only component (see docstring
    # above for the verified derivation). Falls back to 1.0 (unscaled,
    # today's pre-fix behavior) if either input is unavailable, rather than
    # guessing.
    browser_dpr = win_metrics.get("dpr") if win_metrics else None
    zoom_factor = 1.0
    if browser_dpr and backing_scale and zoom_scale_trustworthy:
        zoom_factor = browser_dpr / backing_scale

    result_elements = []
    base_x = base_y = None
    if ax_frame:
        base_x = ax_frame["x"]
        base_y = ax_frame["y"]

    for el in elements:
        item = {
            "tag": el.get("tag"), "text": el.get("text"),
            "vx": el.get("x"), "vy": el.get("y"),
            "vw": el.get("w"), "vh": el.get("h"),
        }
        if base_x is not None:
            item["x"], item["y"] = _viewport_to_screen(
                ax_frame, top_chrome, left_chrome, zoom_factor,
                el.get("x", 0), el.get("y", 0))
        result_elements.append(item)

    return {
        "browser": browser,
        "usedClipboardFallback": used_clipboard,
        "windowMetrics": win_metrics,
        "windowGeometry": ax_frame,
        "jsGeometryAgreesWithAx": geometry_agrees,
        "jsGeometryCheck": geometry_detail,
        "topChrome": top_chrome,
        "topChromeCalibrated": top_chrome_calibrated,
        "topChromeSource": top_chrome_source,
        "topChromeStale": top_chrome_stale,
        "leftChrome": left_chrome,
        "leftChromeCalibrated": left_chrome_calibrated,
        "leftChromeSource": left_chrome_source,
        "leftChromeStale": left_chrome_stale,
        "browserDpr": browser_dpr,
        "backingScaleFactor": backing_scale,
        "backingScaleScreenIndex": backing_scale_screen_index,
        "zoomScaleTrustworthy": zoom_scale_trustworthy,
        "zoomFactor": zoom_factor,
        "elements": result_elements,
    }


def warn_if_uncalibrated(app, top_calibrated, top_source, top_stale,
                          left_calibrated, left_source, left_stale):
    """Shared stderr guard for every web-layer command that computes a
    screen point from chrome-offset math (dom, and every real click that
    goes through real_click_verified: select's combobox commit, fill's
    real-key path, click's web fallback).

    Two distinct cases, both worth a loud warning, previously only one was
    caught (2026-09-01 incident: both real bugs happened with the *Stale
    booleans sitting True in the JSON and nobody looked, so the original
    guard only fired on "stale" -- a PREVIOUSLY-calibrated machine whose
    calibration no longer matches). That guard silently said nothing on a
    FRESH install with no .calibration.json at all (source=="default-guess",
    calibrated=False, stale=False, since "stale" means "was valid, now
    isn't" and a install that was never calibrated was never valid to begin
    with). That's exactly the worst first-run case: no calibration file
    (deliberately not shipped, machine-specific) plus a click that silently
    lands on the wrong element with no explanation. Fires on either case,
    never touches stdout/exit code so it can't break a caller parsing JSON.
    """
    stale = bool(top_stale or left_stale)
    never_calibrated = not (top_calibrated or left_calibrated)
    if not (stale or never_calibrated):
        return
    if never_calibrated:
        sys.stderr.write(
            "WARNING: no calibration found for this machine (.calibration.json is "
            "deliberately not shipped, it's machine/display specific). Coordinates "
            "in this output are an UNCALIBRATED default guess and clicks derived "
            "from them may land on the wrong element. Run `desktop calibrate --app "
            "%s` once, then re-run this command.\n" % app
        )
    else:
        sys.stderr.write(
            "WARNING: coordinates in this output are UNCALIBRATED for the current window "
            "state (topChromeStale=%s source=%s, leftChromeStale=%s source=%s) -- run "
            "`desktop calibrate --app %s` before trusting clicks derived from it\n"
            % (top_stale, top_source, left_stale, left_source, app)
        )


def cmd_dom(args):
    out = dom_query(args.app, args.selector, args.limit, args.top_chrome, args.left_chrome)
    print(json.dumps(out))
    warn_if_uncalibrated(
        args.app,
        out.get("topChromeCalibrated"), out.get("topChromeSource"), out.get("topChromeStale"),
        out.get("leftChromeCalibrated"), out.get("leftChromeSource"), out.get("leftChromeStale"),
    )
    if "error" in out:
        sys.exit(1)


# ---------------------------------------------------------------------------
# real_click_verified: the ONE real-OS-mouse escalation primitive. Every
# other verb that needs an actual click (select's combobox commit, click's
# web fallback, fill's hand-to-human real-key attempt) routes through this,
# so the activate-first fix and the bounds guard only ever need to live in
# one place.
#
# Coordinates come from THE SAME _viewport_to_screen() formula dom_query
# uses (never a second, independently-drifting formula) -- that's the whole
# point of extracting it: a reader and a clicker that agree by construction.
# ---------------------------------------------------------------------------

def real_click_verified(browser, rect, verify_fn):
    """
    rect: {"vx","vy","vw","vh"} in the page's CSS-pixel viewport (as
    returned by getBoundingClientRect()), the SAME shape dom_query/_dom
    element extraction already produces. Clicks the rect's CENTER.

    verify_fn: a zero-arg callable returning (verified: bool,
    verified_by: str|None, detail: any) -- caller-supplied so this stays
    uniform across every use (combobox commit verify, click signature diff,
    fill focus check).

    Sequence (Bug #3's activate-first fix is the one change that mattered
    for the external-monitor intermittency): resolve which display the
    window is actually on, compute the absolute screen point, REFUSE if
    it's outside both the window rect and the resolved display frame
    (never click blind), activate the browser FIRST and let that settle
    (defeats macOS's click-to-focus swallowing the actuating click when the
    app wasn't already frontmost), THEN cliclick, THEN call verify_fn.

    Returns an envelope-shaped dict: {ok, verified, verifiedBy, method:
    "real-click", coords:{x,y,display}, reason, detail}. ok is set iff
    verified is True (section 4's `ok == verified` invariant).

    Fix #1 (Asclepius QA finding, hardware-mirrored display): the AX window
    frame (from `windows --app <browser>`) is the SINGLE ground truth for
    window origin/size here. window.screenX/screenY/outerWidth/outerHeight
    (the JS self-report, still read via _dom_window_metrics for innerW/
    innerH/dpr) are NEVER trusted for positioning -- under a hardware
    mirror (built-in panel mirroring an external ultrawide) Chromium reports
    those as (0,0,fullMirroredDisplayW,fullMirroredDisplayH) instead of the
    real window frame, which silently sent every computed click to the
    wrong point. `jsGeometryCheck` in the returned dict cross-checks the two
    sources (belt-and-suspenders guard) but never changes which numbers get
    used -- see _check_js_geometry_against_ax().
    """
    ax_frame = _arc_window_geometry(browser)
    if not ax_frame:
        return {"ok": False, "verified": False, "verifiedBy": None, "method": "real-click",
                "coords": None, "reason": "no-window-frame", "jsGeometryCheck": None,
                "detail": "could not read %s's AX window frame, refusing to click blind" % browser}

    win_metrics = _dom_window_metrics(browser)
    geometry_agrees, geometry_detail = _check_js_geometry_against_ax(win_metrics, ax_frame)
    if geometry_agrees is False:
        geometry_detail = dict(geometry_detail)
        geometry_detail["note"] = ("window.screenX/screenY/outerWidth/outerHeight disagree with "
                                    "the AX window frame beyond tolerance -- JS self-report "
                                    "REJECTED, using AX frame as ground truth (Fix #1)")

    display = resolve_window_display(browser)
    top_chrome, tcal, tsrc, tstale = get_top_chrome(browser, ax_frame, win_metrics, None)
    left_chrome, lcal, lsrc, lstale = get_left_chrome(browser, ax_frame, win_metrics, None)
    # This is the ONE real-mouse escalation primitive (select's combobox
    # commit, fill's real-key path, click's web fallback all route through
    # here), so this is where an uncalibrated machine's FIRST real click
    # happens -- warn here, not just in `dom`, or a caller who never runs
    # `dom` first never sees the warning at all before something silently
    # clicks the wrong spot.
    warn_if_uncalibrated(browser, tcal, tsrc, tstale, lcal, lsrc, lstale)
    backing_scale, zoom_trustworthy, _idx = _screen_backing_scale_factor(ax_frame)
    browser_dpr = win_metrics.get("dpr") if win_metrics else None
    zoom_factor = 1.0
    if browser_dpr and backing_scale and zoom_trustworthy:
        zoom_factor = browser_dpr / backing_scale

    center_vx = rect.get("vx", 0) + rect.get("vw", 0) / 2.0
    center_vy = rect.get("vy", 0) + rect.get("vh", 0) / 2.0
    abs_x, abs_y = _viewport_to_screen(ax_frame, top_chrome, left_chrome, zoom_factor,
                                        center_vx, center_vy)

    win_w = ax_frame.get("w") or 0
    win_h = ax_frame.get("h") or 0
    in_window = (ax_frame["x"] <= abs_x <= ax_frame["x"] + win_w
                 and ax_frame["y"] <= abs_y <= ax_frame["y"] + win_h)
    in_display = False
    if display and display.get("originXQuartz") is not None:
        in_display = (display["originXQuartz"] <= abs_x <= display["originXQuartz"] + display["widthPoints"]
                      and display["originYQuartz"] <= abs_y <= display["originYQuartz"] + display["heightPoints"])
    coords = {"x": abs_x, "y": abs_y, "display": display.get("screenIndex") if display else None}
    if not in_window and not in_display:
        return {"ok": False, "verified": False, "verifiedBy": None, "method": "real-click",
                "coords": coords, "reason": "point-out-of-bounds",
                "jsGeometryAgreesWithAx": geometry_agrees, "jsGeometryCheck": geometry_detail,
                "detail": ("computed click point (%d,%d) falls outside both the window rect "
                            "and the resolved display frame, refused before clicking" % (abs_x, abs_y))}

    # Activate-first (Bug #3's intermittency fix): when Arc wasn't already
    # frontmost, the FIRST synthetic click only raised the window (macOS's
    # own click-to-focus swallowed the actuating click). Explicitly
    # activating and letting it settle before clicking defeats that.
    run_jxa_ax("activate", {"app": browser})
    time.sleep(0.12)

    click_out = cliclick("c:%d,%d" % (abs_x, abs_y))
    if "error" in click_out:
        return {"ok": False, "verified": False, "verifiedBy": None, "method": "real-click",
                "coords": coords, "reason": "cliclick-failed", "detail": click_out["error"],
                "jsGeometryAgreesWithAx": geometry_agrees, "jsGeometryCheck": geometry_detail}

    time.sleep(0.15)
    verified, verified_by, detail = verify_fn()
    return {
        "ok": bool(verified), "verified": bool(verified),
        "verifiedBy": verified_by if verified else None,
        "method": "real-click", "coords": coords,
        "reason": None if verified else "not-verified-after-real-click",
        "detail": detail,
        "jsGeometryAgreesWithAx": geometry_agrees,
        "jsGeometryCheck": geometry_detail,
    }


# ---------------------------------------------------------------------------
# set-select: set a dropdown's value via JS -- no click, no keystroke to open
# a native OS popup that CGEvents can't drive and that jams the page's JS
# thread while open (see JS_EXEC_TIMEOUT_SECONDS / _arc_execute_js).
#
# Handles TWO distinct widget families, auto-detected by the resolved
# element's tag:
#   1. Native <select>: set .value via the native property setter + dispatch
#      input/change. No click needed, so the native OS popup never opens.
#   2. ARIA/custom combobox (confirmed live on a real web form's
#      an ARIA-role dropdown step: document.querySelectorAll('select')
#      returned ZERO matches even though a dropdown showing "No" was
#      visibly present -- some sites' custom dropdowns are a styled
#      role=combobox/listbox widget, not a native <select>). These are
#      page-rendered JS/CSS, so dispatched click events work on them: click
#      the trigger, poll for the option list to render, click the matching
#      option.
#
# THIS IS A REWRITE (Athena hardening spec, ends a 4-round whack-a-mole).
# The load-bearing change from every prior version: NEVER return success
# without an OBSERVED state transition, and REFUSE rather than guess on
# ambiguity. Every result carries a `status` field from a closed enum (see
# STATUS_* constants below); `status == "ok"` is the only success value, and
# it requires a re-read confirming the field/trigger actually moved, not
# just that a click was dispatched.
#
# Result shape: every returned dict has a `status` key. On success (`ok`)
# it also carries `mode` ("native-select" or "combobox"), `containerSource`
# (combobox only), `selectedText`, and `verifiedBy` (how the transition was
# confirmed: "text" | "aria-selected" | "form-field" | "native-readback").
# On any other status it names what it saw: `optionsSeen`, `containerSource`,
# `matchCount`, `candidates`, or a `detail`/`reason` string -- never a bare
# failure with no context, so a caller can adjust --value/--selector/--name
# instead of re-running blind.
#
# STATUS ENUM:
#   ok                   verified transition; the ONLY exit-0 status.
#   unverified            clicked/set but no confirmed transition (including
#                         a menu that merely closed -- aria-expanded going
#                         true->false ALONE is a WEAK signal, not proof the
#                         value changed, since some widgets close on any
#                         outside interaction). NONZERO exit: an autonomous
#                         apply run must not treat "maybe" as "done".
#   no-match              container resolved+opened, no visible option
#                         matched --value; optionsSeen + containerSource.
#   ambiguous              refused rather than guessed: >1 exact visible
#                         match with no unique value/selector to disambiguate,
#                         or the trigger's own popup container could not be
#                         identified; candidates listed.
#   menu-did-not-open     poll ceiling hit, no candidates ever rendered;
#                         Escape sent.
#   error                  structural failure: target lost mid-flow,
#                         execute-javascript itself failed/timed out, JSON
#                         parse failure, or (see `crossOriginIframeDetected`)
#                         the target may be inside a cross-origin iframe,
#                         which `execute javascript` cannot reach at all
#                         (contentDocument access throws by design -- this is
#                         detected and reported, never silently swallowed).
#
# Every exit path -- success or not -- clears every `data-atlas-*` marker
# this command plants (select-target, preopen, picked, pretext, preexpanded,
# prefieldval, typed) via a dedicated cleanup pass, and sends Escape on any
# non-ok status so a partially-open menu never gets left hanging.
#
# OUT OF SCOPE (detected + reported, not attempted):
#   - Cross-origin iframe listboxes: contentDocument access throws by
#     design; reported via crossOriginIframeDetected, never worked around.
#   - isTrusted-hardened widgets that require a genuine OS-level click:
#     these will surface as `unverified`, not a crash.
#   - Same-origin iframe walking (OPTIONAL per spec): NOT implemented --
#     every one of the JS calls below would need to search inside same-
#     origin iframes too (marker placement, container resolution, verify),
#     which is not "cheap" once threaded through every phase. Left as a
#     residual risk (see README).
# ---------------------------------------------------------------------------

DEFAULT_SET_SELECT_SELECTOR = (
    "select,[role=combobox],[aria-haspopup=listbox],[aria-haspopup=true],"
    "button[aria-expanded][aria-controls]"
)

# Predicate helpers shared by every combobox-phase JS payload below. Inlined
# into each IIFE (each `execute javascript` call is a fresh, stateless
# evaluation -- nothing is shared across calls except the DOM itself).
_PREDICATES_JS = (
    "function normalize(t){return (t||'').replace(/\\s+/g,' ').trim().toLowerCase();}"
    "function isVisible(el){"
    "if(!el)return false;"
    "if(el.closest('[aria-hidden=\"true\"]'))return false;"
    "var st=window.getComputedStyle(el);"
    "if(st.display==='none'||st.visibility==='hidden')return false;"
    "if(el.getClientRects().length===0)return false;"
    "var r=el.getBoundingClientRect();"
    "return r.width>0&&r.height>0;}"
    "function isEnabled(el){"
    "if(el.disabled)return false;"
    "if(el.getAttribute('aria-disabled')==='true')return false;"
    "return true;}"
    "function isLeaf(el,sel){return el.matches(sel)&&!el.querySelector(sel);}"
)

# All markers this command ever plants on the page, for the stale-sweep at
# the top of resolve and the central cleanup pass at the end of every run.
_ATLAS_MARKER_ATTRS = [
    "data-atlas-select-target", "data-atlas-preopen", "data-atlas-picked",
    "data-atlas-pretext", "data-atlas-preexpanded", "data-atlas-prefieldval",
    "data-atlas-typed",
]


_CSS_IDENT_RE = re.compile(r"^-?[_a-zA-Z][_a-zA-Z0-9-]*$")


def _normalize_selector(selector):
    """`#9b56ca6c-...` is NOT a valid CSS selector: an id selector may not start
    with a digit. Some form platforms mint UUID field ids, so this is the
    common case, not an edge case. querySelector throws on those, Arc returns
    `null`, and every caller here used to crash on `None.get(...)`.

    Rewrite a bare `#id` whose id is not a valid CSS identifier into the
    equivalent `[id="..."]` attribute selector, which has no such restriction.
    Anything else is passed through untouched.
    """
    if not selector.startswith("#") or len(selector) < 2:
        return selector
    ident = selector[1:]
    # Only rewrite a plain single-id selector; leave compound/descendant
    # selectors (`#a .b`, `#a>b`) alone rather than guess at their structure.
    if any(c in ident for c in ' >+~[].#:,()'):
        return selector
    if _CSS_IDENT_RE.match(ident):
        return selector
    return '[id="%s"]' % ident.replace('\\', '\\\\').replace('"', '\\"')


def _resolve_select_target_js(selector, name, index):
    """
    Phase 0 (unchanged structure). Finds the `index`-th visible element
    matching `selector` (optionally filtered to ones whose name/id/
    aria-label/associated-<label>-text/own text/ANCESTOR aria-label contains
    `name` as a case-insensitive substring), tags it with a temporary
    `data-atlas-select-target` marker so follow-up calls can address the
    exact same element without re-resolving, and reports its tag/role so
    the python caller can branch native-<select> vs combobox.

    Sweeps ALL `data-atlas-*` markers this command ever plants (not just
    select-target) before resolving, in case a prior run crashed mid-flow
    and left cleanup incomplete.

    `--name` now also walks up to 6 ancestor levels collecting any
    `aria-label` found there -- closes the real gap the prior version had
    (a container div's aria-label, not just the trigger's own, is a common
    place production comboboxes put the accessible label).

    On zero matches, also probes for cross-origin iframes on the page and
    reports the hint (`execute javascript` can never reach inside one --
    contentDocument access throws by design) rather than a bare "not found".
    """
    selector = _normalize_selector(selector)
    sweep = "".join(
        "document.querySelectorAll('[%s]').forEach(function(e){e.removeAttribute('%s');});"
        % (attr, attr)
        for attr in _ATLAS_MARKER_ATTRS
    )
    return (
        "(function(){"
        + sweep +
        "var sel=%s;var nameWanted=(%s||'').toLowerCase();var idx=%d;"
        "function labelText(el){var t='';try{"
        "if(el.id){var lab=document.querySelector('label[for=\"'+CSS.escape(el.id)+'\"]');"
        "if(lab)t+=' '+lab.innerText;}"
        "var pl=el.closest('label');if(pl)t+=' '+pl.innerText;"
        "var al=el.getAttribute('aria-labelledby');if(al){al.split(' ').forEach("
        "function(id){var e2=document.getElementById(id);if(e2)t+=' '+e2.innerText;});}"
        "var anc=el.parentElement;var hops=0;"
        "while(anc&&hops<6){var al2=anc.getAttribute&&anc.getAttribute('aria-label');"
        "if(al2)t+=' '+al2;anc=anc.parentElement;hops++;}"
        "}catch(e){}return t;}"
        "var cands=Array.from(document.querySelectorAll(sel)).filter(function(el){"
        "var st=window.getComputedStyle(el);"
        "if(st.display==='none'||st.visibility==='hidden')return false;"
        "if(!nameWanted)return true;"
        "var hay=((el.getAttribute('aria-label')||'')+' '+(el.id||'')+' '+(el.name||'')"
        "+' '+labelText(el)+' '+(el.tagName==='SELECT'?'':el.textContent)).toLowerCase();"
        "return hay.indexOf(nameWanted)!==-1;});"
        "if(cands.length===0){"
        "var iframes=Array.from(document.querySelectorAll('iframe'));"
        "var crossOrigin=false;"
        "for(var i=0;i<iframes.length;i++){try{var d=iframes[i].contentDocument;"
        "if(!d)crossOrigin=true;}catch(e){crossOrigin=true;}}"
        "return JSON.stringify({status:'error',reason:'no-target-match',"
        "detail:'no element matched selector/name'"
        "+(crossOrigin?' -- target may be inside a cross-origin iframe, unreachable via "
        "execute-javascript':''),"
        "crossOriginIframeDetected:crossOrigin,iframeCount:iframes.length});}"
        "if(idx>=cands.length)return JSON.stringify({status:'error',reason:'index-out-of-range',"
        "detail:'index out of range: only '+cands.length+' match(es) for that selector/name'});"
        "var el=cands[idx];el.setAttribute('data-atlas-select-target','1');"
        "return JSON.stringify({status:'resolved',tag:el.tagName,role:el.getAttribute('role'),"
        "text:(el.tagName==='SELECT'?'':(el.textContent||'')).trim().slice(0,80),"
        "candidatesMatched:cands.length});"
        "})()"
    ) % (json.dumps(selector), json.dumps(name or ""), index)


def _cleanup_markers_js():
    """Central marker-hygiene pass, run on EVERY exit from set_select()
    regardless of which path/status was hit."""
    sweep = "".join(
        "document.querySelectorAll('[%s]').forEach(function(e){e.removeAttribute('%s');});"
        % (attr, attr)
        for attr in _ATLAS_MARKER_ATTRS
    )
    return "(function(){" + sweep + "return JSON.stringify({status:'cleaned'});})()"


# --- Phase 2a: native <select> --------------------------------------------

def _native_select_match_and_set_js(value):
    """Matches `value` against the marked <select>'s options (exact
    normalized text -> exact value -> substring text; >1 exact TEXT match
    with no unique value is refused as ambiguous rather than guessed), then
    sets it via the native property setter
    (Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value').set)
    and dispatches input+change (bubbling). A bare `el.value=` is silently
    swallowed by React's controlled-component valueTracker -- it updates the
    DOM but the framework's own tracker still thinks the old value is
    current, so its onChange never fires. Going through the native setter
    bypasses that shadowing exactly the way a real user interaction would.

    Does NOT remove the marker or claim success here -- that's the verify
    step's job, so a stale marker never masks a mismatch between "we called
    the setter" and "the value actually stuck"."""
    return (
        "(function(){"
        "function normalize(t){return (t||'').replace(/\\s+/g,' ').trim().toLowerCase();}"
        "var el=document.querySelector('[data-atlas-select-target]');"
        "if(!el)return JSON.stringify({status:'error',reason:'target-lost',"
        "detail:'target element lost (page may have re-rendered)'});"
        "var wanted=%s;var wl=normalize(wanted);"
        "var options=Array.from(el.options).filter(function(o){return !o.disabled;});"
        "var exact=options.filter(function(o){return normalize(o.textContent)===wl;});"
        "var match=null;"
        "if(exact.length>1){"
        "var byValue=exact.filter(function(o){return o.value===wanted;});"
        "if(byValue.length===1){match=byValue[0];}else{"
        "return JSON.stringify({status:'ambiguous',reason:'multiple-exact-matches',"
        "matchCount:exact.length,"
        "candidates:exact.map(function(o){return {text:o.textContent.trim(),value:o.value};})});}"
        "}else if(exact.length===1){match=exact[0];}"
        "if(!match)match=options.find(function(o){return o.value===wanted;});"
        "if(!match){"
        "var sub=options.filter(function(o){return normalize(o.textContent).indexOf(wl)!==-1;});"
        "if(sub.length>1){"
        "return JSON.stringify({status:'ambiguous',reason:'multiple-substring-matches',"
        "matchCount:sub.length,"
        "candidates:sub.map(function(o){return {text:o.textContent.trim(),value:o.value};})});}"
        "if(sub.length===1)match=sub[0];}"
        "if(!match){return JSON.stringify({status:'no-match',"
        "optionsSeen:options.map(function(o){return o.textContent.trim();}).slice(0,40)});}"
        "var setter=Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype,'value').set;"
        "setter.call(el,match.value);"
        "el.dispatchEvent(new Event('input',{bubbles:true}));"
        "el.dispatchEvent(new Event('change',{bubbles:true}));"
        "return JSON.stringify({status:'set',matchedValue:match.value,"
        "matchedText:match.textContent.trim(),matchedIndex:el.selectedIndex});"
        "})()"
    ) % json.dumps(value)


def _native_select_verify_js(expected_value, expected_index):
    """Re-reads the marked <select> after a tick: `ok` requires BOTH
    `el.value===expected_value` AND `el.selectedIndex===expected_index`
    (belt-and-braces -- value alone can't distinguish two options that
    legitimately share a value attribute). Removes the marker either way;
    this is the final exit point on the native path."""
    return (
        "(function(){"
        "var el=document.querySelector('[data-atlas-select-target]');"
        "if(el)el.removeAttribute('data-atlas-select-target');"
        "if(!el)return JSON.stringify({status:'error',reason:'target-lost-after-set',"
        "detail:'select element lost between setting the value and verifying it'});"
        "var ok=(el.value===%s)&&(el.selectedIndex===%d);"
        "return JSON.stringify({status:ok?'ok':'unverified',"
        "reason:ok?undefined:'value-did-not-stick',"
        "currentValue:el.value,currentIndex:el.selectedIndex,"
        "currentText:(el.options[el.selectedIndex]?"
        "el.options[el.selectedIndex].textContent.trim():'')});"
        "})()"
    ) % (json.dumps(expected_value), expected_index)


def _set_select_native(browser, value):
    ok, out, err = _arc_execute_js(_native_select_match_and_set_js(value), browser)
    if not ok or not out:
        return {"status": "error", "reason": "execute-js-failed",
                "detail": "setting native select: " + (err or "empty result")}
    try:
        result = _parse_js_json(out)
    except ValueError as e:
        return {"status": "error", "reason": "json-parse-failed",
                "detail": "native-select-set: %s (raw: %s)" % (e, out[:300])}
    if result.get("status") in ("ambiguous", "no-match", "error"):
        return result

    time.sleep(0.05)  # let a controlled-component re-render settle before reading back
    ok2, out2, err2 = _arc_execute_js(
        _native_select_verify_js(result["matchedValue"], result["matchedIndex"]), browser)
    if not ok2 or not out2:
        return {"status": "error", "reason": "execute-js-failed",
                "detail": "verifying native select: " + (err2 or "empty result")}
    try:
        verify = _parse_js_json(out2)
    except ValueError as e:
        return {"status": "error", "reason": "json-parse-failed",
                "detail": "native-select-verify: %s (raw: %s)" % (e, out2[:300])}
    verify["mode"] = "native-select"
    if verify.get("status") == "ok":
        verify["selectedText"] = result.get("matchedText")
        verify["verifiedBy"] = "native-readback"
    return verify


# --- Phase 2b: ARIA/custom combobox ----------------------------------------

def _combobox_open_js():
    """Step 1: snapshot then open, in one call. BEFORE dispatching the open
    click, tags every currently-visible [role=listbox]/[role=menu] with
    data-atlas-preopen (so container tier 3 below can tell a NEWLY-appeared
    popup from one that was already open elsewhere on the page), and records
    the trigger's pre-click normalized text + aria-expanded + (best-effort)
    linked form field value as data attributes, for the verify step to diff
    against later. Then fires the same full pointerdown/mousedown/pointerup/
    mouseup/click sequence used before: this is page-rendered JS/CSS, not an
    OS-native popup, so dispatched (untrusted) events work -- most component
    libraries attach their open-handler via addEventListener on click/
    mousedown, which doesn't require event.isTrusted. Dispatched exactly
    once; nothing below re-toggles it, so the poll loop can retry the SCAN
    safely across the render race without re-opening/re-closing the menu."""
    return (
        "(function(){"
        + _PREDICATES_JS +
        "var trigger=document.querySelector('[data-atlas-select-target]');"
        "if(!trigger)return JSON.stringify({status:'error',reason:'target-lost',"
        "detail:'trigger element lost (page may have re-rendered)'});"
        "Array.from(document.querySelectorAll('[role=\"listbox\"],[role=\"menu\"]'))"
        ".filter(isVisible).forEach(function(el){el.setAttribute('data-atlas-preopen','1');});"
        "trigger.setAttribute('data-atlas-pretext',"
        "normalize(trigger.tagName==='INPUT'?trigger.value:trigger.textContent));"
        "trigger.setAttribute('data-atlas-preexpanded',trigger.getAttribute('aria-expanded')||'');"
        "var fieldScope=trigger.closest('[role=\"combobox\"]')||trigger.parentElement||trigger;"
        "var field=fieldScope.querySelector('input[type=\"hidden\"],select')||"
        "((trigger.tagName==='INPUT'||trigger.tagName==='SELECT')?trigger:null);"
        "if(field)trigger.setAttribute('data-atlas-prefieldval',field.value);"
        "var opts={bubbles:true,cancelable:true,view:window};"
        "try{trigger.dispatchEvent(new PointerEvent('pointerdown',opts));}catch(e){}"
        "trigger.dispatchEvent(new MouseEvent('mousedown',opts));"
        "try{trigger.dispatchEvent(new PointerEvent('pointerup',opts));}catch(e){}"
        "trigger.dispatchEvent(new MouseEvent('mouseup',opts));"
        "trigger.dispatchEvent(new MouseEvent('click',opts));"
        "if(trigger.focus)trigger.focus();"
        "return JSON.stringify({status:'opened',triggerTag:trigger.tagName,"
        "triggerText:(trigger.textContent||'').trim().slice(0,80)});"
        "})()"
    )


def _combobox_scan_js(value, do_scroll, do_type):
    """Step 2: ONE poll iteration. Pure read+match (only clicks the LEAF on
    a committed match) so the python caller can call this repeatedly across
    the render race without re-opening the menu (idempotent scan, single
    open -- invariant 4).

    Container resolution is ordered, refuses rather than falling back to a
    document-global search. An unresolved container is reported as
    pending/container-unresolved (NOT an immediate ambiguous) -- the popup
    may simply not have mounted yet right after the open click, so the
    python caller retries it across the same render-race poll as no-match,
    and only finalizes it to status:'ambiguous' once it's stable across
    consecutive polls or the ceiling is hit:
      1. aria-controls/aria-owns id refs, visible, containing >=1
         option-like descendant.
      2. aria-activedescendant -> closest [role=listbox|menu].
      3. A visible [role=listbox|menu] that LACKS data-atlas-preopen (i.e.
         appeared after this trigger's own open click) -- replaces the old
         fragile ~-sibling/bare-listbox tier, which could collide with an
         unrelated already-open widget sharing the same option text.
      4. The nearest visible [role=listbox|menu] descendant of the
         trigger's own combobox root.
      5. None resolved -> refuse, listing every visible listbox/menu seen.

    Candidate gathering: primary option-role selectors first, filtered
    visible+enabled+leaf (a leaf never contains another candidate --
    a wrapper div around the real option is the same self-vs-descendant
    problem one level down); only if that's empty does it fall back to
    generic clickable descendants, same filter. Tiering is decided on the
    VISIBLE primary count, not the raw querySelectorAll length, so a hidden
    template/state-only primary node can't suppress a real visible fallback
    option.

    Zero candidates: if exactly one visible text input is in scope and
    hasn't been typed into yet, types `value` (native setter + input event)
    and reports pending/typed-filter so the caller re-polls. Else, once past
    the sub-deadline, scrolls the container one page if scrollable and
    reports pending/scrolled. Otherwise pending/rendering.

    Match order (both non-empty-candidate paths): exact-normalized ==,
    then startsWith, then substring. >1 EXACT visible match is refused as
    ambiguous (never silently auto-picked); startsWith/substring ties pick
    the first but report matchCount>1 so the caller can see the tie. Zero
    matches at all reports pending/no-match-yet with optionsSeen -- the
    python caller finalizes this to a real 'no-match' only once optionsSeen
    is stable across two consecutive polls, so a still-rendering list isn't
    prematurely declared a miss.

    On a committed match, tags the leaf with data-atlas-picked (so verify
    can re-find it even after the menu closes) and dispatches the same
    click sequence _combobox_open_js used for the trigger."""
    return (
        "(function(){"
        + _PREDICATES_JS +
        "var wanted=%s;var wl=normalize(wanted);"
        "var doScroll=%s;var doType=%s;"
        "var trigger=document.querySelector('[data-atlas-select-target]');"
        "if(!trigger)return JSON.stringify({status:'error',reason:'target-lost',"
        "detail:'trigger element lost (page may have re-rendered)'});"
        "var primarySel='[role=\"option\"],option,[role=\"menuitem\"],[role=\"menuitemradio\"]';"
        "var fallbackSel='li,button,div,.artdeco-typeahead__result,[data-test-typeahead-result]';"
        "function idsFrom(attr){var v=trigger.getAttribute(attr);"
        "return v?v.split(/\\s+/).filter(Boolean):[];}"
        "var container=null,containerSource=null;"
        "var ownerIds=idsFrom('aria-controls').concat(idsFrom('aria-owns'));"
        "for(var i=0;i<ownerIds.length&&!container;i++){"
        "var c=document.getElementById(ownerIds[i]);"
        "if(c&&isVisible(c)&&(c.querySelector(primarySel)||c.querySelector(fallbackSel))){"
        "container=c;containerSource='aria-controls/owns';}}"
        "if(!container){"
        "var activeId=trigger.getAttribute('aria-activedescendant');"
        "if(activeId){var ad=document.getElementById(activeId);"
        "if(ad){var lb=ad.closest('[role=\"listbox\"],[role=\"menu\"]');"
        "if(lb){container=lb;containerSource='aria-activedescendant';}}}}"
        "if(!container){"
        "var newlyOpened=Array.from(document.querySelectorAll('[role=\"listbox\"],[role=\"menu\"]'))"
        ".filter(function(el){return isVisible(el)&&!el.hasAttribute('data-atlas-preopen');});"
        "if(newlyOpened.length===1){container=newlyOpened[0];containerSource='newly-opened';}}"
        "if(!container){"
        "var root=trigger.closest('[role=\"combobox\"]')||trigger.parentElement;"
        "if(root){var found=Array.from(root.querySelectorAll('[role=\"listbox\"],[role=\"menu\"]'))"
        ".filter(isVisible);"
        "if(found.length===1){container=found[0];containerSource='trigger-root-descendant';}}}"
        "if(!container){"
        "var openSeen=Array.from(document.querySelectorAll('[role=\"listbox\"],[role=\"menu\"]'))"
        ".filter(isVisible).map(function(el){return {role:el.getAttribute('role'),"
        "text:normalize(el.textContent).slice(0,60)};});"
        "return JSON.stringify({status:'pending',reason:'container-unresolved',"
        "candidates:openSeen});}"
        "function gather(sel){return Array.from(container.querySelectorAll(sel))"
        ".filter(function(el){return isVisible(el)&&isEnabled(el)&&isLeaf(el,sel);});}"
        "var cands=gather(primarySel);"
        "if(cands.length===0)cands=gather(fallbackSel);"
        "if(cands.length===0){"
        "if(doType){"
        "var scopeRoot=trigger.closest('[role=\"combobox\"]')||trigger.parentElement||trigger;"
        "var seen=new Set();"
        "var inputs=Array.from(scopeRoot.querySelectorAll('input[type=\"text\"],input:not([type])'))"
        ".concat(Array.from(container.querySelectorAll('input[type=\"text\"],input:not([type])')))"
        ".filter(function(el){if(seen.has(el))return false;seen.add(el);return true;})"
        ".filter(function(el){return isVisible(el)&&!el.hasAttribute('data-atlas-typed');});"
        "if(inputs.length===1){"
        "var inp=inputs[0];inp.setAttribute('data-atlas-typed','1');"
        "var setter=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,'value').set;"
        "setter.call(inp,wanted);"
        "inp.dispatchEvent(new Event('input',{bubbles:true}));"
        "return JSON.stringify({status:'pending',reason:'typed-filter',"
        "containerSource:containerSource});}}"
        "if(doScroll&&container.scrollHeight>container.clientHeight){"
        "container.scrollTop=Math.min(container.scrollTop+container.clientHeight,"
        "container.scrollHeight);"
        "return JSON.stringify({status:'pending',reason:'scrolled',"
        "containerSource:containerSource});}"
        "return JSON.stringify({status:'pending',reason:'rendering',"
        "containerSource:containerSource});}"
        "var exact=cands.filter(function(o){return normalize(o.textContent)===wl;});"
        "var chosen=null,matchCount=0;"
        "if(exact.length>1){"
        "return JSON.stringify({status:'ambiguous',reason:'multiple-exact-matches',"
        "matchCount:exact.length,containerSource:containerSource,"
        "candidates:exact.map(function(o){return normalize(o.textContent).slice(0,60);})});}"
        "if(exact.length===1){chosen=exact[0];matchCount=1;}"
        "if(!chosen){var starts=cands.filter(function(o){"
        "return normalize(o.textContent).indexOf(wl)===0;});"
        "if(starts.length>0){chosen=starts[0];matchCount=starts.length;}}"
        "if(!chosen){var sub=cands.filter(function(o){"
        "return normalize(o.textContent).indexOf(wl)!==-1;});"
        "if(sub.length>0){chosen=sub[0];matchCount=sub.length;}}"
        "if(!chosen){"
        "return JSON.stringify({status:'pending',reason:'no-match-yet',"
        "containerSource:containerSource,"
        "optionsSeen:cands.slice(0,20).map(function(o){"
        "return normalize(o.textContent).slice(0,40);})});}"
        "document.querySelectorAll('[data-atlas-picked]').forEach(function(e){"
        "e.removeAttribute('data-atlas-picked');});"
        "chosen.setAttribute('data-atlas-picked','1');"
        # COMMIT CHANGE (Bug #2 fix): this used to dispatch its OWN
        # pointerdown/mousedown/click sequence on the leaf here -- react-
        # select and styled-component cards ignore that (confirmed live,
        # isTrusted-gated). Instead just report the leaf's rect; the python
        # caller commits with a REAL cliclick via real_click_verified() and
        # re-runs _combobox_verify_js() below to confirm it landed.
        "var r=chosen.getBoundingClientRect();"
        "return JSON.stringify({status:'picked',containerSource:containerSource,"
        "selectedText:normalize(chosen.textContent).slice(0,80),matchCount:matchCount,"
        "tag:chosen.tagName,rect:{vx:r.x,vy:r.y,vw:r.width,vh:r.height}});"
        "})()"
    ) % (json.dumps(value), "true" if do_scroll else "false", "true" if do_type else "false")


def _combobox_verify_js(value):
    """Step 3: re-read after a tick. `ok` requires >=1 STRONG signal:
      - trigger's displayed text now normalized-contains `value` (strongest
        -- this is what a human actually sees change).
      - the data-atlas-picked leaf now has aria-selected/aria-checked=true.
      - a linked form field (nearest hidden input/select in the trigger's
        combobox-root scope, snapshotted pre-open) changed value.
    aria-expanded flipping true->false with NONE of the above is reported
    as unverified/menu-closed-only -- a closed menu proves nothing by
    itself; several widgets close on any outside click, matched or not.
    Removes the trigger marker either way; this is the final exit point on
    the combobox path."""
    return (
        "(function(){"
        "function normalize(t){return (t||'').replace(/\\s+/g,' ').trim().toLowerCase();}"
        "var wl=normalize(%s);"
        "var trigger=document.querySelector('[data-atlas-select-target]');"
        "if(!trigger)return JSON.stringify({status:'error',reason:'trigger-lost-after-click',"
        "detail:'trigger element lost between clicking the option and verifying it'});"
        "var triggerText=normalize(trigger.tagName==='INPUT'?trigger.value:trigger.textContent);"
        "var verifiedBy=null;"
        "if(triggerText.indexOf(wl)!==-1)verifiedBy='text';"
        "var picked=document.querySelector('[data-atlas-picked]');"
        "if(!verifiedBy&&picked){"
        "if(picked.getAttribute('aria-selected')==='true'||"
        "picked.getAttribute('aria-checked')==='true')verifiedBy='aria-selected';}"
        "if(!verifiedBy){"
        "var prev=trigger.getAttribute('data-atlas-prefieldval');"
        "if(prev!==null){"
        "var fieldScope=trigger.closest('[role=\"combobox\"]')||trigger.parentElement||trigger;"
        "var field=fieldScope.querySelector('input[type=\"hidden\"],select')||"
        "((trigger.tagName==='INPUT'||trigger.tagName==='SELECT')?trigger:null);"
        "if(field&&field.value!==prev)verifiedBy='form-field';}}"
        "var preExpanded=trigger.getAttribute('data-atlas-preexpanded');"
        "var nowExpanded=trigger.getAttribute('aria-expanded');"
        "var menuClosedOnly=(!verifiedBy&&preExpanded==='true'&&nowExpanded==='false');"
        # Fix #2 (Asclepius QA, 100% reproducible): only strip the marker on
        # a VERIFIED success. Stripping it unconditionally (on unverified
        # results too, as this used to) meant a retry's re-open call
        # (_combobox_open_js) could never find `[data-atlas-select-target]`
        # again -- every retry past attempt 1 died with 'target-lost',
        # silently making `--retries N` dead beyond the first attempt.
        # On an unverified result the marker is left in place so
        # _set_select_combobox's retry loop can re-open the SAME target;
        # it still gets cleaned up eventually via set_select()'s
        # unconditional _cleanup_markers_js() call on every exit path.
        "if(verifiedBy){trigger.removeAttribute('data-atlas-select-target');"
        "return JSON.stringify({status:'ok',verifiedBy:verifiedBy,"
        "triggerText:triggerText.slice(0,80)});}"
        "return JSON.stringify({status:'unverified',"
        "reason:menuClosedOnly?'menu-closed-only':'no-transition-detected',"
        "triggerText:triggerText.slice(0,80)});"
        "})()"
    ) % json.dumps(value)


def _combobox_open_and_poll_for_pick(browser, value, poll_interval, poll_ceiling):
    """
    One full open-then-poll pass: opens the combobox, then polls
    _combobox_scan_js until it reports a committed match (`status:'picked'`,
    the leaf's rect, ready for a real click) or a terminal non-retryable
    outcome (ambiguous / no-match / menu-did-not-open / error). Does NOT
    click or verify -- that's the caller's job (_set_select_combobox), so a
    failed real-click can re-invoke this to re-open the menu without
    duplicating the poll logic.
    """
    ok, out, err = _arc_execute_js(_combobox_open_js(), browser)
    if not ok or not out:
        return {"status": "error", "reason": "execute-js-failed",
                "detail": "opening combobox: " + (err or "empty result")}
    try:
        open_result = _parse_js_json(out)
    except ValueError as e:
        return {"status": "error", "reason": "json-parse-failed",
                "detail": "combobox-open: %s (raw: %s)" % (e, out[:300])}
    if open_result.get("status") == "error":
        return open_result

    deadline = time.time() + poll_ceiling
    sub_deadline = time.time() + poll_ceiling * 0.5
    prev_options_seen = None
    prev_container_candidates = None
    saw_any_candidates = False
    typed_attempted = False
    last_result = None

    while time.time() < deadline:
        do_scroll = time.time() > sub_deadline
        do_type_now = not typed_attempted
        ok2, out2, err2 = _arc_execute_js(_combobox_scan_js(value, do_scroll, do_type_now), browser)
        if not ok2 or not out2:
            return {"status": "error", "reason": "execute-js-failed",
                    "detail": "scanning combobox: " + (err2 or "empty result")}
        try:
            result = _parse_js_json(out2)
        except ValueError as e:
            return {"status": "error", "reason": "json-parse-failed",
                    "detail": "combobox-scan: %s (raw: %s)" % (e, out2[:300])}
        last_result = result
        status = result.get("status")
        if status in ("error", "ambiguous"):
            return result
        if status == "picked":
            return result

        reason = result.get("reason")
        if reason == "typed-filter":
            typed_attempted = True
        elif reason == "no-match-yet":
            saw_any_candidates = True
            options_seen = result.get("optionsSeen", [])
            if prev_options_seen is not None and options_seen == prev_options_seen:
                return {"status": "no-match", "optionsSeen": options_seen,
                        "containerSource": result.get("containerSource")}
            prev_options_seen = options_seen
        elif reason == "container-unresolved":
            # The trigger's own popup may simply not have mounted yet right
            # after the open click -- only refuse once this is STABLE across
            # consecutive polls, same discipline as no-match-yet, so the
            # early ticks of a normal render race don't get misreported as
            # an unresolvable ambiguity.
            candidates = result.get("candidates", [])
            if prev_container_candidates is not None and candidates == prev_container_candidates:
                return {"status": "ambiguous", "reason": "container-unresolved",
                        "candidates": candidates}
            prev_container_candidates = candidates
        time.sleep(poll_interval)

    if last_result and last_result.get("reason") == "container-unresolved":
        return {"status": "ambiguous", "reason": "container-unresolved",
                "candidates": last_result.get("candidates", [])}
    if not saw_any_candidates:
        return {"status": "menu-did-not-open",
                "detail": "no candidates rendered within the poll ceiling"}
    if last_result and last_result.get("reason") == "no-match-yet":
        return {"status": "no-match", "optionsSeen": last_result.get("optionsSeen", []),
                "containerSource": last_result.get("containerSource")}
    return {"status": "menu-did-not-open",
            "detail": "timed out waiting for options to stabilize"}


def _set_select_combobox(browser, value, retries=3, poll_interval=0.15, poll_ceiling=2.0):
    """
    Open + poll (JS) to locate and mark the matching option, then COMMIT
    with a REAL cliclick at the option's own rect via real_click_verified()
    (Bug #2 fix -- react-select/styled-component options ignore a
    dispatched click, they only respond to a genuine OS-level one).
    Re-verifies with _combobox_verify_js() same as before. On an unverified
    real-click, re-opens the menu and retries the whole open+poll+click
    cycle up to `retries` times -- a single miscommit shouldn't be fatal if
    the widget is still in a clickable state after re-opening.
    """
    last_failure = None
    for attempt in range(1, retries + 1):
        picked = _combobox_open_and_poll_for_pick(browser, value, poll_interval, poll_ceiling)
        status = picked.get("status")
        if status != "picked":
            # ambiguous / no-match / menu-did-not-open / error are semantic
            # failures, not "the click didn't land" -- retrying a real click
            # won't fix a widget that never rendered the option at all, so
            # these return immediately rather than burning retries.
            return picked

        def _verify():
            time.sleep(0.12)  # let the widget's own click handler update text/aria state
            ok3, out3, err3 = _arc_execute_js(_combobox_verify_js(value), browser)
            if not ok3 or not out3:
                return False, None, "verifying combobox selection: " + (err3 or "empty result")
            try:
                v = _parse_js_json(out3)
            except ValueError as e:
                return False, None, "combobox-verify: %s (raw: %s)" % (e, out3[:300])
            if v.get("status") == "ok":
                return True, v.get("verifiedBy"), v
            return False, None, v

        click_result = real_click_verified(browser, picked["rect"], _verify)
        if click_result["ok"]:
            verify_detail = click_result["detail"] if isinstance(click_result["detail"], dict) else {}
            result = dict(verify_detail)
            result["status"] = "ok"
            result["mode"] = "combobox"
            result["method"] = "js->real-click"
            result["attempts"] = attempt
            result["containerSource"] = picked.get("containerSource")
            result["selectedText"] = picked.get("selectedText")
            result["coords"] = click_result["coords"]
            return result

        last_failure = click_result
        run_jxa_key("escape", {})  # close whatever's left open before re-opening

    return {"status": "unverified", "reason": "real-click-did-not-verify-after-retries",
            "attempts": retries, "detail": last_failure.get("detail") if last_failure else None,
            "mode": "combobox"}


def _parse_js_json(out):
    """Same double-decode every JS-returning helper here needs: AppleScript
    prints a JSON string as a quoted, escaped literal, which is itself valid
    JSON for a string."""
    parsed = json.loads(json.loads(out) if out.startswith('"') else out)
    if parsed is None:
        # Arc returns the literal `null` when the injected JS threw (most often
        # an invalid CSS selector). Surface that as a parse error the callers
        # already handle, instead of handing back None for them to `.get()`.
        raise ValueError("JS returned null (the injected script most likely threw)")
    return parsed


def set_select(browser, selector, name, index, value, retries=3):
    if not _is_app_running(browser):
        return {"status": "error", "reason": "app-not-running",
                "detail": "%s is not running -- set-select will not auto-launch a browser, "
                          "open it first" % browser}

    ok, out, err = _arc_execute_js(_resolve_select_target_js(selector, name, index), browser)
    if not ok or not out:
        return {"status": "error", "reason": "execute-js-failed",
                "detail": "resolving target: " + (err or "empty result")}
    try:
        resolved = _parse_js_json(out)
    except ValueError as e:
        return {"status": "error", "reason": "json-parse-failed",
                "detail": "resolve-target: %s (raw: %s)" % (e, out[:300])}
    if resolved.get("status") == "error":
        return resolved

    if resolved.get("tag") == "SELECT":
        result = _set_select_native(browser, value)
    else:
        result = _set_select_combobox(browser, value, retries=retries)

    # Marker hygiene (invariant 5): clear every marker on every exit, success
    # or not. Best-effort -- a failed cleanup call doesn't change the result
    # the caller already has, it just means a marker may linger until the
    # next set-select's stale-sweep clears it.
    _arc_execute_js(_cleanup_markers_js(), browser)

    if result.get("status") != "ok":
        run_jxa_key("escape", {})  # don't leave a partially-open menu hanging
    return result


def cmd_set_select(args):
    # Deprecated alias (kept for one release, per the rebuild spec) --
    # identical behavior to `select`, just the old verb name and no
    # --retries flag of its own (uses the default).
    out = set_select(args.app, args.selector, args.name, args.index, args.value)
    out["deprecated"] = "set-select is deprecated, use `select` instead"
    print(json.dumps(out))
    if out.get("status") != "ok":
        sys.exit(1)


def cmd_select(args):
    out = set_select(args.app, args.selector, args.name, args.index, args.value, args.retries)
    print(json.dumps(out))
    if out.get("status") != "ok":
        sys.exit(1)


# ---------------------------------------------------------------------------
# uniform command envelope (section 1 of the rebuild spec). `fill` and the
# web mode of `click` return exactly this shape. `ok` is true ONLY when
# `verified` is true -- no command reports success off an unread-back
# dispatch.
# ---------------------------------------------------------------------------

def make_envelope(ok, action, verified, verifiedBy=None, method=None, attempts=1,
                   target=None, value=None, coords=None, escalation=None,
                   reason=None, detail=None):
    env = {
        "ok": bool(ok) and bool(verified),
        "action": action,
        "verified": bool(verified),
        "verifiedBy": verifiedBy if verified else None,
        "method": method,
        "attempts": attempts,
        "target": target,
        "value": value,
        "coords": coords,
        "escalation": escalation,
    }
    if not env["ok"]:
        env["reason"] = reason
    if detail is not None:
        env["detail"] = detail
    return env


# ---------------------------------------------------------------------------
# fill: React-safe native setter + input/change/blur, the JS-bridge-first
# replacement for `type` on web content (Bug #1 -- synthetic keystrokes
# never reached a single Arc web input, the native setter + dispatched
# events did, 100% of the time). Reuses _resolve_select_target_js verbatim
# (it's not select-specific, it just marks whichever element matched).
# ---------------------------------------------------------------------------

_FILL_HELPERS_JS = (
    "function normalize(t){return (t||'').replace(/\\s+/g,' ').trim();}"
    "function findErrorNode(el){"
    "function byId(id){return id?document.getElementById(id):null;}"
    "var described=(el.getAttribute('aria-describedby')||'').split(/\\s+/).filter(Boolean);"
    "for(var i=0;i<described.length;i++){var n=byId(described[i]);if(n)return n;}"
    "var em=byId(el.getAttribute('aria-errormessage'));if(em)return em;"
    "var scope=el.parentElement||el;"
    "var sib=scope.querySelector('[aria-invalid=\"true\"]');"
    "if(sib&&sib!==el){var sibErr=sib.parentElement&&sib.parentElement.querySelector("
    "'.ant-form-item-explain,[role=\"alert\"],[class*=\"error\"]');if(sibErr)return sibErr;}"
    "var container=el.closest('.ant-form-item')||el.closest('[class*=\"form-item\"]')||scope;"
    "var explain=container.querySelector('.ant-form-item-explain');if(explain)return explain;"
    "var alertNode=container.querySelector('[role=\"alert\"]');if(alertNode)return alertNode;"
    "var errClass=container.querySelector('[class*=\"error\"]');if(errClass)return errClass;"
    "return null;}"
    # React's controlled-component valueTracker silently swallows a bare
    # `el.value=`, same reason _native_select_match_and_set_js goes through
    # the native property setter instead -- picked per tag so a <textarea>
    # or (rare, via fill) a <select> get their own prototype's setter.
    "function nativeSetterFor(el){"
    "var proto=HTMLInputElement.prototype;"
    "if(el instanceof HTMLTextAreaElement)proto=HTMLTextAreaElement.prototype;"
    "else if(el instanceof HTMLSelectElement)proto=HTMLSelectElement.prototype;"
    "return Object.getOwnPropertyDescriptor(proto,'value').set;}"
)


def _fill_set_js(value):
    """Phase 1: set the value on the marked target via the React-safe
    native setter, dispatch input then change then blur, and snapshot the
    validation-error node's text BEFORE the set (so the caller can diff
    against the after-set read and tell "error changed" from "error was
    already there"). Does not read back the value itself -- that's
    _fill_read_js()'s job, run after a short settle so a controlled
    component's re-render has happened."""
    return (
        "(function(){"
        + _FILL_HELPERS_JS +
        "var el=document.querySelector('[data-atlas-select-target]');"
        "if(!el)return JSON.stringify({status:'error',reason:'target-lost',"
        "detail:'target element lost (page may have re-rendered)'});"
        "var errBeforeNode=findErrorNode(el);"
        "var errBefore=errBeforeNode?normalize(errBeforeNode.textContent):'';"
        "var setter=nativeSetterFor(el);"
        "setter.call(el,%s);"
        "el.dispatchEvent(new Event('input',{bubbles:true}));"
        "el.dispatchEvent(new Event('change',{bubbles:true}));"
        "el.blur();"
        "var r=el.getBoundingClientRect();"
        "return JSON.stringify({status:'set',tag:el.tagName,errorTextBefore:errBefore,"
        "rect:{vx:r.x,vy:r.y,vw:r.width,vh:r.height}});"
        "})()"
    ) % json.dumps(value)


def _fill_read_js():
    """Re-read after the settle. Does NOT remove the marker (fill() clears
    it via the shared _cleanup_markers_js() on every exit path, same
    discipline as set_select()) -- a possible hand-to-human escalation
    still needs to find the same element by marker afterward."""
    return (
        "(function(){"
        + _FILL_HELPERS_JS +
        "var el=document.querySelector('[data-atlas-select-target]');"
        "if(!el)return JSON.stringify({status:'error',reason:'target-lost-after-set',"
        "detail:'target element lost between setting the value and reading it back'});"
        "var errNode=findErrorNode(el);"
        "var errText=errNode?normalize(errNode.textContent):'';"
        "var r=el.getBoundingClientRect();"
        "return JSON.stringify({status:'read',value:el.value,errorText:errText,tag:el.tagName,"
        "rect:{vx:r.x,vy:r.y,vw:r.width,vh:r.height}});"
        "})()"
    )


def _fill_check_focused_js():
    """Used only by the hand-to-human real-key attempt's real_click_verified
    call, to confirm the real click actually focused the marked field
    before typing at it."""
    return (
        "(function(){"
        "var el=document.querySelector('[data-atlas-select-target]');"
        "return JSON.stringify({focused: !!(el&&document.activeElement===el)});"
        "})()"
    )


def _escalate_fill_to_human(browser, value, label, current_value, validation_error,
                             validation_error_before, rect, await_human_secs):
    """
    Section 5. Terminal, documented, non-looping. Called only when the
    native setter's value demonstrably reached the form (readback matched
    `value`) but a validation error persists (the Ant `data-is-phone`
    signature: required -> invalid format, never clearing). Sequence, each
    step read-back-verified, stops at first success:
      1. (already done by the caller before this is invoked: native setter
         + input/change/blur.)
      2. ONE real-key attempt: real_click_verified() to focus the field for
         real, then a real cliclick keystroke sequence + Enter. Expected to
         fail on genuinely fiber-gated Arc web content (see spec's open
         items) -- succeeding is a bonus, not a contract change.
      3. Still non-empty error -> emit the escalation ONCE. No retry loop.
    Optional await_human_secs: after emitting, poll the field until the
    error clears or the timeout is hit, rather than a hard non-blocking
    return.

    validation_error_before (Fix #3): the error text read BEFORE the native
    setter ran (_fill_set_js's errorTextBefore), needed to prove the
    escalation is a real "error changed required->invalid" case and not
    "error was already there, the fill did nothing". _fill_set_js computed
    this all along but fill() never read it back until this fix -- the
    escalation payload only ever surfaced the AFTER error.
    """
    def _verify_focus():
        ok, out, err = _arc_execute_js(_fill_check_focused_js(), browser)
        if not ok or not out:
            return False, None, "execute-js-failed checking focus: " + (err or "empty result")
        try:
            r = _parse_js_json(out)
        except ValueError as e:
            return False, None, "json-parse-failed: %s" % e
        return bool(r.get("focused")), ("focused" if r.get("focused") else None), r

    real_key_attempted = False
    if rect:
        focus_result = real_click_verified(browser, rect, _verify_focus)
        if focus_result["ok"]:
            real_key_attempted = True
            # Clear whatever the native setter already put there first --
            # a real cliclick keystroke sequence TYPES INTO the field on
            # top of existing content, it doesn't replace it (confirmed
            # live: without this, the field ended up with the value
            # doubled/appended).
            run_jxa_key("a", {"cmd": True})
            run_jxa_key("delete", {})
            cliclick("t:%s" % value)
            run_jxa_key("return", {})
            time.sleep(0.15)

    error_after = validation_error
    current_after = current_value
    ok2, out2, err2 = _arc_execute_js(_fill_read_js(), browser)
    if ok2 and out2:
        try:
            r2 = _parse_js_json(out2)
            if r2.get("status") == "read":
                error_after = r2.get("errorText", "")
                current_after = r2.get("value", current_value)
        except ValueError:
            pass

    if not error_after:
        return {"ok": True, "verified": True, "verifiedBy": "error-cleared",
                "method": "js->real-key" if real_key_attempted else "js",
                "currentValue": current_after}

    escalation = {
        "ok": False, "verified": False, "verifiedBy": None,
        "method": "js->real-click" if real_key_attempted else "js",
        "currentValue": current_after,
        # Fix #3: surface BOTH error strings -- validationErrorBefore (read
        # before the native setter ran) proves this is a real "required ->
        # invalid" transition, not "the error was already there and fill
        # did nothing"; validationError is the AFTER state a human still
        # needs to clear.
        "field": {"label": label, "currentValue": current_after,
                  "validationError": error_after,
                  "validationErrorBefore": validation_error_before},
        "detail": "Type %r into %s manually, then continue." % (value, label or "the field"),
    }

    if await_human_secs:
        deadline = time.time() + await_human_secs
        while time.time() < deadline:
            time.sleep(1.0)
            ok3, out3, _err3 = _arc_execute_js(_fill_read_js(), browser)
            if ok3 and out3:
                try:
                    r3 = _parse_js_json(out3)
                except ValueError:
                    r3 = None
                if r3 and r3.get("status") == "read" and not r3.get("errorText"):
                    escalation["ok"] = True
                    escalation["verified"] = True
                    escalation["verifiedBy"] = "error-cleared"
                    escalation["currentValue"] = r3.get("value")
                    escalation["awaitedHuman"] = True
                    return escalation
        escalation["awaitedHuman"] = True
        escalation["awaitTimedOut"] = True
    return escalation


def fill(browser, selector, name, index, value, press_enter=False, verify=True, await_human_secs=None):
    if not _is_app_running(browser):
        return make_envelope(False, "fill", False, reason="app-not-running",
                              detail="%s is not running, fill will not auto-launch a browser, "
                                     "open it first" % browser)

    ok, out, err = _arc_execute_js(_resolve_select_target_js(selector, name, index), browser)
    if not ok or not out:
        return make_envelope(False, "fill", False, reason="execute-js-failed",
                              detail="resolving target: " + (err or "empty result"))
    try:
        resolved = _parse_js_json(out)
    except ValueError as e:
        return make_envelope(False, "fill", False, reason="json-parse-failed",
                              detail="resolve-target: %s (raw: %s)" % (e, out[:300]))
    if resolved.get("status") == "error":
        return make_envelope(False, "fill", False, reason=resolved.get("reason", "resolve-failed"),
                              detail=resolved.get("detail"))

    label = resolved.get("text") or name

    ok2, out2, err2 = _arc_execute_js(_fill_set_js(value), browser)
    if not ok2 or not out2:
        _arc_execute_js(_cleanup_markers_js(), browser)
        return make_envelope(False, "fill", False, reason="execute-js-failed",
                              detail="setting value: " + (err2 or "empty result"))
    try:
        set_result = _parse_js_json(out2)
    except ValueError as e:
        _arc_execute_js(_cleanup_markers_js(), browser)
        return make_envelope(False, "fill", False, reason="json-parse-failed",
                              detail="fill-set: %s (raw: %s)" % (e, out2[:300]))
    if set_result.get("status") == "error":
        _arc_execute_js(_cleanup_markers_js(), browser)
        return make_envelope(False, "fill", False, reason=set_result.get("reason", "set-failed"),
                              detail=set_result.get("detail"),
                              target={"tag": None, "selector": selector, "label": label})

    tag = set_result.get("tag")
    rect = set_result.get("rect")
    target = {"tag": tag, "selector": selector, "label": label, "rect": rect}
    # Fix #3: _fill_set_js already computes this (the error text BEFORE the
    # native setter ran), but it used to be dropped on the floor here -- the
    # hand-to-human escalation only ever surfaced the AFTER error.
    error_text_before = set_result.get("errorTextBefore") or ""

    if not verify:
        # Section 4's `ok == verified` invariant holds even here -- skipping
        # verification means the caller does not get to claim `ok`, it just
        # gets the dispatch done faster. This is the honest tradeoff of
        # --no-verify, not a way to force a false success.
        _arc_execute_js(_cleanup_markers_js(), browser)
        return make_envelope(False, "fill", False, method="js", target=target,
                              value={"wanted": value}, reason="verification-skipped",
                              detail="--no-verify requested: value dispatched but not read back, "
                                     "ok cannot be asserted")

    time.sleep(0.08)
    ok3, out3, err3 = _arc_execute_js(_fill_read_js(), browser)
    if not ok3 or not out3:
        _arc_execute_js(_cleanup_markers_js(), browser)
        return make_envelope(False, "fill", False, reason="execute-js-failed",
                              detail="reading back value: " + (err3 or "empty result"), target=target)
    try:
        read_result = _parse_js_json(out3)
    except ValueError as e:
        _arc_execute_js(_cleanup_markers_js(), browser)
        return make_envelope(False, "fill", False, reason="json-parse-failed",
                              detail="fill-read: %s (raw: %s)" % (e, out3[:300]), target=target)
    if read_result.get("status") == "error":
        _arc_execute_js(_cleanup_markers_js(), browser)
        return make_envelope(False, "fill", False, reason=read_result.get("reason", "read-failed"),
                              detail=read_result.get("detail"), target=target)

    readback = read_result.get("value")
    error_text = read_result.get("errorText") or ""
    rect = read_result.get("rect") or rect
    target["rect"] = rect
    value_info = {"wanted": value, "readback": readback, "validationError": error_text}
    value_matches = (readback == value) or (isinstance(readback, str) and readback.strip() == value.strip())

    if value_matches and not error_text:
        _arc_execute_js(_cleanup_markers_js(), browser)
        env = make_envelope(True, "fill", True, verifiedBy="value-readback", method="js",
                             target=target, value=value_info)
        if press_enter:
            env["enterResult"] = run_jxa_key("return", {})
        return env

    if value_matches and error_text:
        # Value demonstrably reached the form, but the validator won't
        # clear -- section 5's hand-to-human case, not a plain failure.
        esc = _escalate_fill_to_human(browser, value, label, readback, error_text,
                                       error_text_before, rect, await_human_secs)
        _arc_execute_js(_cleanup_markers_js(), browser)
        final_value = {"wanted": value, "readback": esc.get("currentValue", readback),
                        "validationError": "" if esc.get("ok") else error_text}
        env = make_envelope(esc.get("ok", False), "fill", esc.get("verified", False),
                             verifiedBy=esc.get("verifiedBy"), method=esc.get("method", "js"),
                             target=target, value=final_value,
                             escalation=None if esc.get("ok") else "hand-to-human",
                             reason=None if esc.get("ok") else "validated-input-rejects-synthetic",
                             detail=esc.get("detail"))
        if not esc.get("ok") and esc.get("field"):
            env["field"] = esc["field"]
        if esc.get("awaitedHuman"):
            env["awaitedHuman"] = True
        return env

    # readback didn't match the wanted value at all -- a plain failure, not
    # an escalation case (escalation is specifically for "value arrived but
    # validator rejects it", not "value never arrived").
    _arc_execute_js(_cleanup_markers_js(), browser)
    return make_envelope(False, "fill", False, reason="value-did-not-stick",
                          detail="native setter dispatched but readback %r != wanted %r"
                                 % (readback, value),
                          target=target, value=value_info)


def cmd_fill(args):
    out = fill(args.app, args.selector, args.name, args.index, args.value,
               press_enter=args.enter, verify=not args.no_verify,
               await_human_secs=args.await_human)
    print(json.dumps(out))
    if not out.get("ok"):
        sys.exit(1)


