# macro: stop-on-failure sequence of the actions above
# ---------------------------------------------------------------------------

def _run_macro_action_inner(action):
    kind = action.get("action")
    if kind == "click":
        double = action.get("double", False)
        right = action.get("right", False)
        if not double and not right:
            press_out = ax_press(action["role"], action["name"], action.get("index", 0),
                                  action.get("app"))
            if "error" not in press_out:
                press_out["method"] = "ax-press"
                return press_out
        el, err = find_one(action["role"], action["name"], action.get("index", 0),
                            action.get("app"))
        if err:
            return err
        out = click_xy(el["cx"], el["cy"], double, right)
        out["matchedElement"] = el
        out["method"] = "coordinate-click"
        return out
    if kind == "click-xy":
        return click_xy(action["x"], action["y"], action.get("double", False),
                         action.get("right", False), action.get("fromView"))
    if kind == "type":
        text = action["text"]
        if text == "":
            return {"ok": True, "noop": True}
        out = cliclick("t:%s" % text)
        if action.get("enter") and "error" not in out:
            out["enterResult"] = run_jxa_key("return", {})
        return out
    if kind == "key":
        return run_jxa_key(action["key"], {
            "cmd": action.get("cmd", False), "shift": action.get("shift", False),
            "option": action.get("option", False), "control": action.get("control", False),
        })
    if kind == "wait":
        if action.get("dom"):
            browser = action.get("app") or "Arc"
            deadline = time.time() + action.get("timeout", 10)
            role_wanted = (action.get("role") or "any").lower()
            name_wanted = (action.get("name") or "").lower()
            while time.time() < deadline:
                result = dom_query(browser, DEFAULT_DOM_SELECTOR, 300,
                                    action.get("topChrome"), action.get("leftChrome"))
                if "error" not in result:
                    for el in result.get("elements", []):
                        tag_match = role_wanted in ("any", "") or (el.get("tag") or "").lower() == role_wanted
                        name_match = not name_wanted or name_wanted in (el.get("text") or "").lower()
                        if tag_match and name_match:
                            if action.get("click") and el.get("x") is not None:
                                return click_xy(el["x"], el["y"])
                            return {"ok": True, "found": True, "element": el, "mode": "dom"}
                time.sleep(0.5)
            return {"error": "dom wait timed out for role=%s name=%s"
                              % (action.get("role"), action.get("name"))}
        deadline = time.time() + action.get("timeout", 10)
        while time.time() < deadline:
            el, err = find_one(action["role"], action["name"], action.get("index", 0),
                                action.get("app"))
            if el:
                if action.get("click"):
                    return click_xy(el["cx"], el["cy"])
                return {"ok": True, "found": True, "element": el}
            time.sleep(0.3)
        return {"error": "wait timed out for role=%s name=%s" % (action.get("role"), action.get("name"))}
    if kind == "focus":
        return run_jxa_ax("activate", {"app": action["app"]})
    return {"error": "unknown macro action: " + str(kind)}


def run_macro_action(action):
    """
    Wraps _run_macro_action_inner so a malformed action (missing a required
    key like "role"/"name"/"text"/"app", a KeyError) becomes a clean
    stop-on-failure JSON error instead of an uncaught traceback escaping
    past cmd_macro's `if "error" in out` check.
    """
    try:
        return _run_macro_action_inner(action)
    except Exception as e:
        return {"error": "malformed action: %s (action was: %s)" % (e, json.dumps(action))}


def cmd_macro(args):
    try:
        actions = json.loads(args.actions_json)
    except ValueError as e:
        die("invalid macro JSON: %s" % e)
    if not isinstance(actions, list):
        die("macro JSON must be an array of action objects")

    results = []
    for i, action in enumerate(actions):
        out = run_macro_action(action)
        action_kind = action.get("action") if isinstance(action, dict) else None
        results.append({"index": i, "action": action_kind, "result": out})
        if "error" in out:
            print(json.dumps({"ok": False, "stoppedAt": i, "results": results}))
            sys.exit(1)
    print(json.dumps({"ok": True, "results": results}))


